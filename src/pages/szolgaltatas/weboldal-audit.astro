---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderAstro from '../../components/HeaderAstro.astro';
import Footer from '../../components/Footer';
import MobileStickyBar from '../../components/MobileStickyBar';
import ProblemLandingPageV2 from '../../components/ProblemLandingPageV2';

const pageTitle = 'Weboldal audit és javítási terv | Levente Studio';
const pageDescription = 'Technikai SEO, teljesítmény, UX, ajánlat és analitika egy átfogó weboldal-auditban. Prioritásos javítási terv és megvalósítási lehetőség.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/szolgaltatas/weboldal-audit/#service',
  'name': 'Weboldal audit és javítási terv',
  'description': 'Technikai, SEO-, UX-, konverziós és analitikai audit szolgáltató vállalkozásoknak.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Weboldal audit', 'Konverzióaudit', 'Prioritásos javítási terv'],
};

const problemData = {
  h1: 'Weboldal audit, ami nem egy PDF-nél ér véget.',
  intro: 'A cél nem az, hogy minél több hibát soroljunk fel. Azt keressük, melyik technikai, SEO-, UX- vagy mérési probléma akadályozza leginkább az ügyfélszerzést – és mi az a javítás, amit üzletileg először érdemes megcsinálni.',
  symptoms: [
    'Van weboldal, de nem világos, miért kevés a megkeresés',
    'Több külön eszköz működik, de nincs közös mérési kép',
    'SEO, sebesség és UX problémák keverednek',
    'A hirdetési forgalom és a landing nincs összhangban',
    'Nem tudod, javítani kell-e a meglévő oldalt vagy újraépíteni',
  ],
  causes: {
    title: 'Mitől lehet gyenge a rendszer',
    items: [
      'Technikai SEO és indexelési hibák',
      'Lassú vagy mobilon súrlódó felhasználói élmény',
      'Nem elég konkrét ajánlat vagy CTA',
      'Hiányos GA4/GTM és konverziómérés',
      'A weboldal, hirdetés és leadkezelés külön rendszerként működik',
    ],
  },
  auditScope: {
    title: 'Mit nézünk át',
    items: [
      'Technikai SEO és indexelhetőség',
      'PageSpeed és Core Web Vitals',
      'Mobil UX és első képernyős ajánlat',
      'CTA-k és kapcsolatfelvételi út',
      'GA4/GTM és lead események',
      'SEO/hirdetés/landing illeszkedés',
    ],
  },
  deliverables: {
    title: 'Mit kapsz',
    items: [
      'Prioritásos javítási lista üzleti hatás szerint',
      'Konkrét javítási sorrend',
      'Technikai és SEO teendők',
      'Konverziós és CTA-javaslatok',
      'Mérési terv a valódi leadekhez',
      'Megvalósítási terv, ha a javítást is ránk bíznád',
    ],
  },
  faq: [
    {
      question: 'Ez klasszikus weboldal audit?',
      answer: 'A technikai és SEO audit része benne van, de a fókusz az üzleti folyamaton van: hogyan jut el a látogató a valódi kapcsolatfelvételig, és ezt hogyan mérjük.',
    },
    {
      question: 'Meg is csináljátok a javításokat?',
      answer: 'Igen. Az audit külön is kérhető, de ha van értelme, a javításból teljesebb webes és ügyfélszerzési megoldást is tudunk építeni.',
    },
    {
      question: 'Milyen hozzáférések kellenek?',
      answer: 'A weboldal publikus vizsgálata hozzáférés nélkül is elkezdhető. GA4, Search Console és GTM hozzáféréssel viszont sokkal pontosabb képet kapunk.',
    },
    {
      question: 'WordPress, Wix vagy Shopify is lehet?',
      answer: 'Igen. Először a problémát vizsgáljuk, nem a platformot. Ha a meglévő rendszer javítható, nem kell automatikusan újraépíteni.',
    },
    {
      question: 'Mennyibe kerül?',
      answer: 'Az audit mélysége az oldal és a rendszer összetettségétől függ. Első egyeztetés után konkrét, tételes ajánlatot adunk.',
    },
  ],
  cta: {
    title: 'Nézzük meg, mi akadályozza az ügyfélszerzést',
    subtitle: 'Küldd el az oldalad és írd meg röviden, mi nem működik. Nem sablonlistából indulunk: azt keressük meg, hol van a legnagyobb üzleti súrlódás.',
  },
  relatedProblems: [
    {
      title: 'Weboldal nem hoz ügyfelet',
      url: '/weboldal-nem-hoz-ugyfelet/',
      description: 'Konverziós és ügyfélszerzési probléma feltárása',
    },
    {
      title: 'Lassú weboldal',
      url: '/lassu-weboldal/',
      description: 'Teljesítmény- és Core Web Vitals audit',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/szolgaltatas/weboldal-audit/"
  structuredData={structuredData}
>
  <MobileStickyBar />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  
</BaseLayout>
