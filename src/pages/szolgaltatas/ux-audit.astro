---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderAstro from '../../components/HeaderAstro.astro';
import Footer from '../../components/Footer';
import CookieBanner from '../../components/CookieBanner';
import MobileStickyBar from '../../components/MobileStickyBar';
import ProblemLandingPageV2 from '../../components/ProblemLandingPageV2';

const pageTitle = 'UX audit és konverziós áttekintés | Levente Studio';
const pageDescription = 'UX audit szolgáltató weboldalakhoz: első képernyő, ajánlat, CTA, mobilélmény, kapcsolatfelvétel és konverziós út elemzése, prioritásos javítási tervvel.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/szolgaltatas/ux-audit/#service',
  'name': 'UX audit és konverziós áttekintés',
  'description': 'Felhasználói út, ajánlat, CTA és kapcsolatfelvételi folyamat elemzése szolgáltató vállalkozásoknak.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['UX audit', 'Konverzióoptimalizálás', 'Landing audit'],
};

const problemData = {
  h1: 'UX audit, ami nem a gombszínekről szól.',
  intro: 'A jó felhasználói élmény azt jelenti, hogy az érdeklődő gyorsan megérti, mit kínálsz, miért bízzon benned és mi legyen a következő lépése. Ezt az utat vizsgáljuk végig – mobilon és asztali gépen is.',
  symptoms: [
    'Sokan érkeznek az oldalra, de kevés a kapcsolatfelvétel',
    'Az első képernyőn nem egyértelmű az ajánlat',
    'A CTA-k túl sokfélék vagy elbújnak',
    'Mobilon hosszú, zsúfolt vagy nehézkes az oldal',
    'Az űrlap vagy ajánlatkérés túl sok súrlódást okoz',
  ],
  causes: {
    title: 'Hol szokott megtörni a felhasználói út',
    items: [
      'Nem egyértelmű értékajánlat és prioritás',
      'Gyenge bizalomépítés vagy túl sok információ egyszerre',
      'Nem következetes CTA-hierarchia',
      'Mobilon rossz ritmus, olvashatóság vagy navigáció',
      'A kapcsolatfelvétel több munkát kér, mint amennyit az érdeklődő vállalna',
    ],
  },
  auditScope: {
    title: 'Mit nézünk át',
    items: [
      'Első képernyő és értékajánlat',
      'Navigáció és információs hierarchia',
      'CTA-k és kapcsolatfelvételi pontok',
      'Mobil UX és olvashatóság',
      'Űrlapok és ajánlatkérési folyamat',
      'Mérés: hol esnek ki a látogatók',
    ],
  },
  deliverables: {
    title: 'Mit kapsz',
    items: [
      'Prioritásos UX-problémalista',
      'Konkrét CTA- és struktúrajavaslatok',
      'Mobilos javítási pontok',
      'Űrlap- és kapcsolatfelvételi egyszerűsítés',
      'Mérési pontok a konverziós út ellenőrzéséhez',
      'Megvalósítási opció a fontos javításokra',
    ],
  },
  faq: [
    {
      question: 'Kell hozzá heatmap?',
      answer: 'Nem feltétlenül, de ha van használható viselkedési adat, sokat segíthet. Először a meglévő adatokból és a felhasználói útból indulunk ki.',
    },
    {
      question: 'Új dizájnt is készítetek?',
      answer: 'Ha szükséges, igen. De nem automatikusan újratervezünk mindent: először azt javítjuk, ami ténylegesen akadályozza a felhasználót.',
    },
    {
      question: 'Landing page-re is kérhető?',
      answer: 'Igen, sőt hirdetési landingeknél különösen fontos a tiszta ajánlat és rövid konverziós út.',
    },
    {
      question: 'Mobil külön is vizsgálva van?',
      answer: 'Igen. Szolgáltatói oldalaknál a mobilélmény sokszor elsődleges, ezért külön kezeljük.',
    },
    {
      question: 'Garantálható jobb konverzió?',
      answer: 'Fix növekedést nem ígérünk. A javításokat mérhető hipotézisekhez kötjük, és ahol van elég forgalom, vissza lehet mérni a hatást.',
    },
  ],
  cta: {
    title: 'Nézzük meg, hol akad el a látogató',
    subtitle: 'Küldd el az oldalt és írd meg, melyik kapcsolatfelvétel lenne számodra értékes. A felhasználói utat ehhez a célhoz képest vizsgáljuk.',
  },
  relatedProblems: [
    {
      title: 'Weboldal nem hoz ügyfelet',
      url: '/weboldal-nem-hoz-ugyfelet/',
      description: 'Átfogó ügyfélszerzési audit',
    },
    {
      title: 'Weboldal audit',
      url: '/szolgaltatas/weboldal-audit/',
      description: 'Technikai, SEO és UX átvilágítás egyben',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/szolgaltatas/ux-audit/"
  structuredData={structuredData}
>
  <MobileStickyBar client:idle />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  <CookieBanner client:load />
</BaseLayout>
