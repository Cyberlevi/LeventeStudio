---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderAstro from '../../components/HeaderAstro.astro';
import Footer from '../../components/Footer';
import MobileStickyBar from '../../components/MobileStickyBar';
import ProblemLandingPageV2 from '../../components/ProblemLandingPageV2';

const pageTitle = 'SEO audit és keresési áttekintés | Levente Studio';
const pageDescription = 'Technikai SEO, indexelés, tartalmi struktúra, keresési szándék és mérés egy rendszerben. Prioritásos SEO-javítási terv szolgáltató vállalkozásoknak.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/szolgaltatas/seo-audit/#service',
  'name': 'SEO audit és keresési áttekintés',
  'description': 'Technikai SEO, keresési szándék, tartalmi struktúra és mérés átvizsgálása.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['SEO audit', 'Technikai SEO', 'Keresési stratégia'],
};

const problemData = {
  h1: 'SEO audit, ami megmutatja, hol veszíted el a keresési lehetőséget.',
  intro: 'Nem csak hibákat keresünk a Search Console-ban. A technikai alapokat, a kulcsszavak mögötti keresési szándékot, a tartalmi struktúrát és a konverziómérést együtt nézzük, hogy lásd, hol van valódi növekedési lehetőség.',
  symptoms: [
    'Van tartalom, de kevés az organikus megkeresés',
    'Fontos oldalak nem indexelődnek vagy gyengén rangsorolnak',
    'Nem világos, mely kulcsszavak hoznak üzletileg értékes látogatót',
    'A szolgáltatásoldalak egymással versenyeznek',
    'Nincs összekötve a SEO-forgalom a valódi leadekkel',
  ],
  causes: {
    title: 'Mi szokta visszafogni a keresési jelenlétet',
    items: [
      'Indexelési, canonical vagy belső linkelési hibák',
      'A tartalom nem fedi le jól a keresési szándékot',
      'Gyenge vagy túl általános szolgáltatásoldal-struktúra',
      'Technikai teljesítmény és mobil UX problémák',
      'Nincs mérve, melyik organikus oldalból lesz valódi lead',
    ],
  },
  auditScope: {
    title: 'Mit nézünk át',
    items: [
      'Search Console és indexelési mintázatok',
      'Technikai SEO és crawl struktúra',
      'Kulcsszó- és keresési szándék térkép',
      'Szolgáltatásoldalak és belső linkelés',
      'Tartalmi hiányok és kannibalizáció',
      'SEO-forgalom és konverziómérés kapcsolata',
    ],
  },
  deliverables: {
    title: 'Mit kapsz',
    items: [
      'Prioritásos technikai SEO-javítási lista',
      'Keresési szándék szerinti oldaltérkép',
      'Tartalmi és belső linkelési javaslatok',
      'Indexelési és canonical teendők',
      'Mérési terv az organikus leadekhez',
      'Megvalósítási opció a fontos SEO-oldalakhoz',
    ],
  },
  faq: [
    {
      question: 'Kulcsszókutatás is része?',
      answer: 'Igen, de nem önmagában listaként. A kulcsszavakat keresési szándék, szolgáltatás és üzleti érték szerint rendezzük.',
    },
    {
      question: 'Mikor várható SEO eredmény?',
      answer: 'A technikai hibák javítása gyorsan ellenőrizhető, a rangsorolás és organikus növekedés viszont jellemzően hosszabb folyamat. Fix időt vagy helyezést nem ígérünk.',
    },
    {
      question: 'Tartalmat is készítetek?',
      answer: 'A struktúrát és a tartalmi briefet igen, és szükség esetén a megvalósításban is tudunk segíteni.',
    },
    {
      question: 'Local SEO is belefér?',
      answer: 'Igen, helyi szolgáltatóknál a szolgáltatásoldalak, Google Business Profile és lokális keresési szándék különösen fontos.',
    },
    {
      question: 'Csak SEO-t néztek?',
      answer: 'A SEO-t mindig a weboldal és a leadfolyamat részeként kezeljük, ezért a konverzió és mérés is része a képnek.',
    },
  ],
  cta: {
    title: 'Nézzük meg, hol van valódi organikus növekedési lehetőség',
    subtitle: 'Küldd el a weboldalt és írd meg, mely szolgáltatások fontosak neked. A cél nem több kulcsszó, hanem jobb keresési lefedettség és mérhetőbb ügyfélszerzés.',
  },
  relatedProblems: [
    {
      title: 'Google nem indexel',
      url: '/google-nem-indexel/',
      description: 'Technikai indexelési akadályok feltárása',
    },
    {
      title: 'Weboldal audit',
      url: '/szolgaltatas/weboldal-audit/',
      description: 'Átfogó weboldal-audit',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/szolgaltatas/seo-audit/"
  structuredData={structuredData}
>
  <MobileStickyBar />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  
</BaseLayout>
