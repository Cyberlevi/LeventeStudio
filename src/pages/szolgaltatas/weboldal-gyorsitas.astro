---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderAstro from '../../components/HeaderAstro.astro';
import Footer from '../../components/Footer';
import CookieBanner from '../../components/CookieBanner';
import MobileStickyBar from '../../components/MobileStickyBar';
import ProblemLandingPageV2 from '../../components/ProblemLandingPageV2';

const pageTitle = 'Weboldal gyorsítás és Core Web Vitals javítás | Levente Studio';
const pageDescription = 'Weboldal gyorsítás mérés alapján: PageSpeed, Core Web Vitals, képek, JavaScript, CSS, cache és szerver. Prioritásos javítás, nem vak optimalizálás.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/szolgaltatas/weboldal-gyorsitas/#service',
  'name': 'Weboldal gyorsítás és teljesítményoptimalizálás',
  'description': 'Core Web Vitals, PageSpeed és technikai teljesítmény javítása mérés alapján.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Weboldal gyorsítás', 'Core Web Vitals', 'Teljesítményoptimalizálás'],
};

const problemData = {
  h1: 'Weboldal gyorsítás mérés alapján – nem pluginok vaktában kapcsolgatásával.',
  intro: 'A gyorsításnál először azt kell megérteni, mi a valódi szűk keresztmetszet. Kép, JavaScript, font, szerver, cache vagy harmadik fél script? A cél nem egy szép PageSpeed-szám önmagában, hanem gyorsabb és stabilabb felhasználói élmény.',
  symptoms: [
    'Mobilon lassan jelenik meg a fő tartalom',
    'PageSpeed pontszám gyenge vagy nagyon ingadozó',
    'Core Web Vitals hibák jelennek meg',
    'Sok plugin vagy script terheli a betöltést',
    'A hirdetési landing lassúsága ronthatja a kampány hatékonyságát',
  ],
  causes: {
    title: 'Mi lehet a valódi szűk keresztmetszet',
    items: [
      'Túl nagy képek és rossz betöltési stratégia',
      'Render-blocking JavaScript vagy CSS',
      'Fontok és harmadik fél scriptek',
      'Cache/CDN vagy szerverválasz problémák',
      'Túl nehéz CMS sablon vagy pluginhalmozás',
    ],
  },
  auditScope: {
    title: 'Mit mérünk és vizsgálunk',
    items: [
      'LCP, CLS, INP és TTFB',
      'PageSpeed/Lighthouse mobil és desktop',
      'Képméretek és formátumok',
      'JavaScript és CSS betöltési útvonal',
      'Font- és harmadik fél erőforrások',
      'Cache, CDN és szerver viselkedés',
    ],
  },
  deliverables: {
    title: 'Mit kapsz',
    items: [
      'Kiinduló teljesítménymérés',
      'Prioritásos optimalizálási terv',
      'Konkrét kép/script/CSS javítások',
      'Cache és szerver javaslat, ha szükséges',
      'Visszamérés a módosítások után',
      'Megvalósítási opció a technikai javításokra',
    ],
  },
  faq: [
    {
      question: 'Garantált a 100-as PageSpeed?',
      answer: 'Nem ez a cél, és nem is lenne korrekt minden rendszerre garantálni. A fontos felhasználói mutatókat és a valós szűk keresztmetszeteket javítjuk.',
    },
    {
      question: 'WordPress oldalt is gyorsítotok?',
      answer: 'Igen. Plugin, sablon, kép, cache és hosting szinten is lehet optimalizálni.',
    },
    {
      question: 'Kell hostingot váltani?',
      answer: 'Csak akkor, ha a mérés szerint tényleg a szerver a korlát. Nem cserélünk infrastruktúrát reflexből.',
    },
    {
      question: 'SEO-ban is segít?',
      answer: 'A jobb technikai teljesítmény és felhasználói élmény hasznos, de a SEO eredmény több tényezőtől függ. A gyorsítás önmagában nem SEO-stratégia.',
    },
    {
      question: 'Visszaméritek a változást?',
      answer: 'Igen. A javítás akkor értelmezhető, ha ugyanazokat a fontos mutatókat utána is újramérjük.',
    },
  ],
  cta: {
    title: 'Nézzük meg, mi lassítja ténylegesen az oldalt',
    subtitle: 'Küldd el az URL-t. Előbb mérünk, utána optimalizálunk – így nem olyan dolgokra költünk időt, amelyeknek alig van valós hatása.',
  },
  relatedProblems: [
    {
      title: 'Lassú weboldal audit',
      url: '/lassu-weboldal/',
      description: 'Ha először csak fel akarod tárni az okot',
    },
    {
      title: 'Weboldal audit',
      url: '/szolgaltatas/weboldal-audit/',
      description: 'Átfogó weboldal-audit',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/szolgaltatas/weboldal-gyorsitas/"
  structuredData={structuredData}
>
  <MobileStickyBar client:idle />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  <CookieBanner client:load />
</BaseLayout>
