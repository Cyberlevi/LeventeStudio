---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderAstro from '../../components/HeaderAstro.astro';
import Footer from '../../components/Footer';
import CookieBanner from '../../components/CookieBanner';
import MobileStickyBar from '../../components/MobileStickyBar';

const title = 'Tudástár – SEO, konverzió, teljesítmény és mérés | Levente Studio';
const description = 'Gyakorlati útmutatók szolgáltató vállalkozások digitális ügyfélszerzéséhez: SEO, Search Console, konverzió, weboldal teljesítmény és rendszerdiagnózis.';

const blogPosts = [
  {
    title: 'Mikor érdemes weboldal auditot kérni – és mikor felesleges?',
    description: 'Mikor csökkenti valóban a bizonytalanságot egy audit vagy rendszerdiagnózis, és mikor jobb rögtön javítani vagy építeni?',
    url: '/blog/mikor-erdemes-weboldal-auditot-kerni/',
    date: '2025. január 31.',
    readTime: '7 perc',
    tags: ['Diagnózis', 'Weboldal', 'Döntés']
  },
  {
    title: 'Weboldal konverzió optimalizálás – mit nézz meg hirdetés előtt?',
    description: 'Ajánlat, message match, mobilélmény, bizalom, CTA, űrlap és valódi leadmérés egy fizetett kampány előtt.',
    url: '/blog/weboldal-konverzio-optimalizalas/',
    date: '2025. január 31.',
    readTime: '9 perc',
    tags: ['Konverzió', 'Landing', 'Hirdetés']
  },
  {
    title: 'Google Search Console hibák – mit jelentenek, és mit érdemes javítani?',
    description: 'Indexelési, crawl és canonical problémák értelmezése anélkül, hogy minden kizárt URL-t hibának néznél.',
    url: '/blog/google-search-console-hibak/',
    date: '2025. január 31.',
    readTime: '9 perc',
    tags: ['SEO', 'Search Console', 'Indexelés']
  },
  {
    title: 'Miért lassú a WordPress oldalam? 7 ok, amit sorrendben ellenőrizz',
    description: 'Képek, pluginok, JavaScript, fontok, cache, hosting és külső scriptek diagnózisa mérés alapján.',
    url: '/blog/miert-lassu-a-wordpress-oldalam/',
    date: '2025. január 31.',
    readTime: '10 perc',
    tags: ['WordPress', 'Sebesség', 'Core Web Vitals']
  },
  {
    title: 'UX audit specifikáció – mit érdemes ténylegesen megvizsgálni?',
    description: 'Első képernyő, navigáció, CTA, mobilélmény, űrlapok, bizalom és mérés egy használható UX auditban.',
    url: '/blog/ux-audit-specifikacio/',
    date: '2025. január 31.',
    readTime: '8 perc',
    tags: ['UX', 'Konverzió', 'Mérés']
  }
];
---

<BaseLayout title={title} description={description} canonical="/blog/">
  <CookieBanner client:load />
  <MobileStickyBar client:load />
  <HeaderAstro />

  <main>
    <section class="pt-36 pb-20 px-6 bg-cream-50 relative overflow-hidden">
      <div class="absolute inset-0 studio-grid pointer-events-none"></div>
      <div class="max-w-6xl mx-auto relative">
        <div class="studio-kicker text-taupe-500 mb-5">Tudástár · Levente Studio</div>
        <h1 class="font-serif text-5xl md:text-7xl font-light text-taupe-900 leading-[0.98] mb-7 max-w-4xl">
          Kevesebb marketing-zaj.
          <span class="block text-taupe-600">Több használható rendszerlogika.</span>
        </h1>
        <p class="text-xl text-taupe-700 font-light max-w-3xl leading-relaxed">
          SEO, konverzió, teljesítmény és mérés szolgáltató vállalkozásoknak. Olyan témák, amelyekből jobb döntést lehet hozni – nem csak több szakzsargont megtanulni.
        </p>
      </div>
    </section>

    <section class="py-20 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid gap-6 md:grid-cols-2">
          {blogPosts.map((post, index) => (
            <article class="studio-card border-taupe-200 bg-taupe-50/40 group">
              <a href={post.url} class="block p-7 md:p-8 h-full">
                <div class="flex items-center justify-between gap-4 text-xs uppercase tracking-[0.12em] text-taupe-500 mb-7">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{post.readTime}</span>
                </div>

                <h2 class="font-serif text-3xl font-light text-taupe-900 mb-4 leading-tight group-hover:text-taupe-600 transition-colors">
                  {post.title}
                </h2>
                <p class="text-taupe-700 font-light leading-relaxed mb-7">
                  {post.description}
                </p>

                <div class="flex flex-wrap gap-2 mb-8">
                  {post.tags.map((tag) => (
                    <span class="text-xs px-3 py-1.5 border border-taupe-200 bg-white text-taupe-600 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="flex items-center justify-between border-t border-taupe-200 pt-5">
                  <time class="text-sm text-taupe-500">{post.date}</time>
                  <span class="text-sm text-taupe-900 group-hover:translate-x-1 transition-transform">Olvasom →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-taupe-900 text-cream-50">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-end md:justify-between gap-8">
        <div class="max-w-2xl">
          <div class="studio-kicker text-cream-300 mb-4">Nem csak olvasnál?</div>
          <h2 class="font-serif text-4xl md:text-5xl font-light mb-4">Nézzük meg a saját rendszeredet.</h2>
          <p class="text-cream-200 font-light text-lg">Ha valamelyik probléma ismerős, nem kell még tíz cikket elolvasni. Megkeressük, nálad hol van a legnagyobb súrlódás.</p>
        </div>
        <a href="/kapcsolat/" class="inline-flex items-center justify-center px-7 py-4 bg-cream-50 text-taupe-900 rounded-sm hover:bg-cream-100 transition-colors whitespace-nowrap">
          Rendszertervezés
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
