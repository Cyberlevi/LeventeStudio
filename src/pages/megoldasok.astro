---
import { ArrowRight, Gauge, Globe2, Target, Workflow } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import SubpageHero from '../components/SubpageHero.astro';
import MobileStickyBar2026 from '../components/MobileStickyBar2026';
import { studioOffers } from '../data/studio-offers';

const iconById = { PRESENCE: Globe2, START: Gauge, GROW: Target, SCALE: Workflow } as const;
const offers = studioOffers.map(offer => ({
  ...offer,
  icon: iconById[offer.id],
  eyebrow: `${offer.code} · ${offer.id}`,
  text: offer.description,
}));
---

<BaseLayout
  title="Weboldalcsomagok és ügyfélszerzés | Levente Studio"
  description="Presence, Start, Grow és Scale csomagok szolgáltató vállalkozásoknak: online jelenlét, weboldal, ügyfélszerzés és rendezettebb ügyfélkezelés."
  canonical="/megoldasok/"
>
  <HeaderAstro />
  <MobileStickyBar2026 />
  <main class="bg-graphite-950 text-white">
    <SubpageHero
      eyebrow="Levente Studio · megoldások"
      title="Négy csomag."
      accent="Egy logikus út."
      description="Nem ugyanarra van szüksége minden vállalkozásnak. A vállalkozásod jelenlegi helyzete dönti el, hogy profi jelenlétre, jó weboldalra, tudatosabb ügyfélszerzésre vagy rendezettebb ügyfélkezelésre van szükség."
      primaryHref="#megoldasok"
      primaryLabel="Csomagok"
      secondaryHref="/kapcsolat/#diagnosztika"
      secondaryLabel="Ajánlatot kérek"
      meta={['Presence', 'Start', 'Grow', 'Scale']}
    />

    <section id="megoldasok" class="hightech-section bg-graphite-900 relative overflow-hidden">
      <div class="absolute inset-0 studio-grid-dark opacity-20" aria-hidden="true"></div>
      <div class="hightech-container relative">
        <div class="max-w-4xl mb-12 sm:mb-14">
          <div class="text-xs uppercase tracking-[.18em] text-signal-400 mb-4">Csomagok</div>
          <h2 class="font-serif text-4xl sm:text-6xl font-light leading-[.94]">A legkisebb szükséges megoldással kezdünk. <span class="text-signal-400">Nem a legdrágábbal.</span></h2>
          <p class="mt-6 text-base sm:text-lg text-white/60 leading-relaxed max-w-3xl">A négy szint egymásra épül, de nem kell végiglépkedni rajtuk. Ha már működő weboldalad van, indulhatunk GROW vagy SCALE szintről is.</p>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5">
          {offers.map(({ icon: Icon, eyebrow, title, text, price, href }, index) => (
            <a href={href} class:list={[
              'p-7 md:p-8 min-h-[430px] flex flex-col group transition duration-300',
              index === 2 ? 'border border-signal-400/30 bg-graphite-950 shadow-[0_24px_80px_rgba(0,0,0,.25)]' : 'tech-card-dark'
            ]}>
              <div class="flex justify-between items-start gap-4">
                <span class="text-[10px] uppercase tracking-[.18em] text-signal-400">{eyebrow}</span>
                <Icon className="w-5 h-5 text-signal-400" />
              </div>
              {index === 2 && <div class="mt-6 inline-flex self-start border border-signal-400/25 px-2.5 py-1 text-[10px] uppercase tracking-[.16em] text-signal-400">Növekedési csomag</div>}
              <h3 class="font-serif text-4xl font-light leading-[.95] mt-10">{title}</h3>
              <p class="text-white/60 leading-relaxed mt-5">{text}</p>
              <div class="mt-auto pt-10">
                <div class="text-xl text-white mb-5">{price}</div>
                <span class="inline-flex items-center gap-2 text-signal-400">Részletek <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" /></span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-12 border border-white/10 p-7 md:p-9 flex flex-col md:flex-row gap-6 md:items-center md:justify-between">
          <div>
            <div class="text-xs uppercase tracking-[.18em] text-signal-400 mb-2">Nem tudod, melyik kell?</div>
            <h2 class="font-serif text-3xl md:text-4xl font-light">Nem neked kell kitalálnod.</h2>
            <p class="text-white/55 mt-3">A rövid ajánlatkérés alapján megkeressük, hol érdemes kezdeni — és ha a Presence elég, nem fogunk Scale-t eladni.</p>
          </div>
          <a href="/kapcsolat/#diagnosztika" data-track-cta="Ajánlatot kérek" data-track-location="solutions_bottom" class="signal-button-primary inline-flex shrink-0">Ajánlatot kérek <ArrowRight className="w-4 h-4" /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
