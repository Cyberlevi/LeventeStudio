---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import MobileStickyBar from '../components/MobileStickyBar';
import ProblemLandingPageV2 from '../components/ProblemLandingPageV2';

const pageTitle = 'Lassú weboldal? Teljesítményaudit és javítási terv | Levente Studio';
const pageDescription = 'Lassú betöltés, gyenge PageSpeed vagy Core Web Vitals? Átnézzük, mi fogja vissza az oldalt, és prioritásos javítási tervet készítünk.';
const canonicalURL = '/lassu-weboldal/';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/lassu-weboldal/#service',
  'name': 'Weboldal teljesítményaudit',
  'description': 'PageSpeed, Core Web Vitals, képek, JavaScript, CSS és szerveroldali teljesítmény átvizsgálása.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Weboldal gyorsítás', 'Teljesítmény audit', 'Core Web Vitals optimalizálás'],
};

const problemData = {
  h1: 'Lassú weboldal? Nézzük meg, mi okozza – és mi éri meg javítani.',
  intro: 'A sebesség önmagában nem cél. Az a kérdés, hogy a lassúság rontja-e a felhasználói élményt, a keresési jelenlétet vagy a konverziót. Először feltárjuk a szűk keresztmetszetet, utána csak azt javítjuk, aminek valódi hatása van.',
  symptoms: [
    'PageSpeed Insights mobilon gyenge vagy ingadozó',
    'Core Web Vitals figyelmeztetések jelennek meg',
    'Mobilon sokáig üres vagy ugráló a kezdőképernyő',
    'Nagy képek, sok script vagy túl sok plugin terheli az oldalt',
    'A landing hirdetésből lassan nyílik meg és romlik a konverzió',
  ],
  causes: {
    title: 'Mi szokta lassítani a weboldalt',
    items: [
      'Túlméretezett vagy rossz formátumú képek',
      'Felesleges JavaScript és render-blocking erőforrások',
      'Gyenge szerverválasz, cache vagy CDN hiány',
      'Túl sok plugin vagy nehéz sablon',
      'Nem optimalizált CSS, fontbetöltés vagy harmadik féltől érkező script',
    ],
  },
  auditScope: {
    title: 'Mit nézünk meg a teljesítményauditban',
    items: [
      'PageSpeed és Lighthouse mobil/desktop mérés',
      'Core Web Vitals: LCP, CLS, INP és TTFB',
      'Képformátum, méretezés és lazy loading',
      'JavaScript/CSS terhelés és render útvonal',
      'Szerver, cache és CDN viselkedés',
      'Harmadik fél scriptek és mérési kódok hatása',
    ],
  },
  deliverables: {
    title: 'Mit kapsz a végén',
    items: [
      'Mérési alapállapot a fontos teljesítménymutatókkal',
      'Prioritásos hibalista hatás szerint',
      'Konkrét javítási terv: mit érdemes, és mit nem érdemes bántani',
      'Kép-, script- és CSS-optimalizálási javaslatok',
      'Hosting/cache/CDN javaslat csak akkor, ha tényleg indokolt',
      'Megvalósítási opció a szükséges technikai javításokra',
    ],
  },
  faq: [
    {
      question: 'Mennyivel lesz gyorsabb az oldalam?',
      answer: 'Ezt mérés nélkül nem korrekt előre megmondani. Először azonosítjuk a valódi szűk keresztmetszetet, utána már lehet reális célértéket adni.',
    },
    {
      question: 'Muszáj hostingot váltani?',
      answer: 'Nem. Csak akkor javasoljuk, ha a szerver ténylegesen a fő korlát. Sok esetben képek, scriptek és renderelés javításával nagyobb eredmény érhető el.',
    },
    {
      question: 'WordPress oldal is jöhet?',
      answer: 'Igen. Pluginok, sablon, adatbázis és cache szinten is meg lehet keresni a problémát.',
    },
    {
      question: 'A gyorsítás SEO-t is javít?',
      answer: 'A teljesítmény fontos technikai tényező, de önmagában nem SEO-stratégia. A cél a jobb felhasználói élmény és a technikai akadályok csökkentése.',
    },
    {
      question: 'Meg is csináljátok a javítást?',
      answer: 'Igen, ha az audit alapján van értelmes és biztonságos beavatkozási terv.',
    },
  ],
  cta: {
    title: 'Nézzük meg, mi lassítja ténylegesen az oldalt',
    subtitle: 'Küldd el az URL-t és írd meg, hol érzed a problémát. Először a valódi szűk keresztmetszetet keressük meg, nem vaktában optimalizálunk.',
  },
  relatedProblems: [
    {
      title: 'Google nem indexel',
      url: '/google-nem-indexel/',
      description: 'Indexelési és technikai SEO problémák feltárása',
    },
    {
      title: 'Weboldal nem hoz ügyfelet',
      url: '/weboldal-nem-hoz-ugyfelet/',
      description: 'Az ügyfélszerzési út átfogó auditja',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalURL}
  structuredData={structuredData}
>
  <MobileStickyBar />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  
</BaseLayout>
