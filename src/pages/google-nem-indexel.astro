---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';
import ProblemLandingPageV2 from '../components/ProblemLandingPageV2';

const pageTitle = 'Google nem indexel? Technikai SEO diagnózis | Levente Studio';
const pageDescription = 'Ha Google nem indexeli az oldalad, feltárjuk a technikai okot: Search Console, robots, sitemap, canonical, renderelés és szerverhibák – prioritásos javítási tervvel.';
const canonicalURL = '/google-nem-indexel/';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/google-nem-indexel/#service',
  'name': 'Google indexelési és technikai SEO diagnózis',
  'description': 'Indexelési problémák, Search Console hibák és technikai SEO blokkok feltárása és javítási terve.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Technikai SEO', 'Indexelési audit', 'Search Console diagnózis'],
};

const problemData = {
  h1: 'Google nem indexel? Keressük meg, mi blokkolja.',
  intro: 'Ha egy fontos oldal nincs az indexben, annak lehet technikai, tartalmi vagy struktúrából eredő oka. Nem egyetlen gombot keresünk a Search Console-ban: végignézzük, hogy a Google hozzáfér-e, érti-e és érdemesnek látja-e indexelni az oldalt.',
  symptoms: [
    'Search Console: "Discovered - currently not indexed" vagy hasonló státusz',
    'Az oldal hónapok óta él, mégsem jelenik meg a Google-ben',
    'Csak a főoldal indexelődik, fontos aloldalak nem',
    'A sitemap be van küldve, de az URL-ek státusza bizonytalan',
    'Canonical, redirect vagy duplikációs figyelmeztetések jelennek meg',
  ],
  causes: {
    title: 'Mi blokkolhatja az indexelést',
    items: [
      'Robots.txt vagy meta robots tiltás',
      'Hibás, hiányos vagy elavult sitemap',
      'Canonical és duplikációs probléma',
      'JavaScript/renderelési akadály vagy gyenge belső linkelés',
      'Szerverhiba, redirect lánc, DNS vagy elérhetőségi probléma',
    ],
  },
  auditScope: {
    title: 'Mit nézünk meg a technikai SEO diagnózisban',
    items: [
      'Search Console Pages/Indexing státuszok és mintázatok',
      'Robots.txt és meta robots szabályok',
      'XML sitemap és URL-készlet',
      'Canonical, redirect és duplikációs viselkedés',
      'Googlebot elérhetőség és renderelési kockázatok',
      'Belső linkelés, tartalmi érték és indexelhetőségi jelek',
    ],
  },
  deliverables: {
    title: 'Mit kapsz a végén',
    items: [
      'Oldalcsoportonkénti diagnózis: miért lehet indexelési probléma',
      'Prioritásos technikai javítási lista',
      'Robots, sitemap és canonical javaslatok',
      'Redirect és szerveroldali hibák javítási terve',
      'Search Console ellenőrzési és visszamérési folyamat',
      'Megvalósítási opció, ha a technikai javítást is ránk bíznád',
    ],
  },
  faq: [
    {
      question: 'Mennyi idő alatt indexelődik az oldal?',
      answer: 'Erre nincs garantált határidő. A technikai blokk javítható, de az indexelés időzítéséről végül a Google dönt. A cél, hogy minden olyan akadályt megszüntessünk, ami rajtunk múlik.',
    },
    {
      question: 'Mi van, ha technikai hiba nincs?',
      answer: 'Akkor meg kell nézni a tartalmi minőséget, duplikációt, belső linkelést és azt, hogy az oldal mennyire ad egyedi értéket a kereső számára.',
    },
    {
      question: 'Kell Search Console hozzáférés?',
      answer: 'Nagyon hasznos, mert nélküle kevesebb közvetlen jel áll rendelkezésre. Ha nincs megfelelő hozzáférés, abban is tudunk segíteni, hogyan legyen rendesen beállítva.',
    },
    {
      question: 'WordPress oldal is jöhet?',
      answer: 'Igen. Yoast, Rank Math, sablon és plugin oldali indexelési hibákat is meg lehet vizsgálni.',
    },
    {
      question: 'Garancia van, hogy bekerül a Google-be?',
      answer: 'Indexelést senki nem tud korrektül garantálni. A technikai akadályokat viszont azonosítani és javítani lehet, és utána mérhető, hogy változik-e a státusz.',
    },
  ],
  cta: {
    title: 'Nézzük meg, miért nem látja jól a Google az oldalt',
    subtitle: 'Küldd el az URL-t és – ha van – a Search Console problémát. Először azt választjuk szét, mi technikai blokk, mi tartalmi kérdés, és mi az, amin nem érdemes vakon változtatni.',
  },
  relatedProblems: [
    {
      title: 'Lassú weboldal',
      url: '/lassu-weboldal/',
      description: 'PageSpeed, Core Web Vitals és teljesítménydiagnózis',
    },
    {
      title: 'Weboldal nem hoz ügyfelet',
      url: '/weboldal-nem-hoz-ugyfelet/',
      description: 'Az ügyfélszerzési út teljes diagnózisa',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalURL}
  structuredData={structuredData}
>
  <MobileStickyBar client:idle />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  <CookieBanner client:load />
</BaseLayout>
