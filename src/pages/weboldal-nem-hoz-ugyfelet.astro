---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';
import ProblemLandingPageV2 from '../components/ProblemLandingPageV2';

const pageTitle = 'Weboldal nem hoz ügyfelet? Audit és javítási terv | Levente Studio';
const pageDescription = 'Van weboldalad, de kevés a megkeresés? Átnézzük a technikát, SEO-t, ajánlatot, mérési rendszert és a lead útját – majd prioritásos javítási tervet készítünk.';
const canonicalURL = '/weboldal-nem-hoz-ugyfelet/';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://leventestudio.app/weboldal-nem-hoz-ugyfelet/#service',
  'name': 'Weboldal és ügyfélszerzési audit',
  'description': 'Weboldal, SEO, UX, ajánlat, analitika és leadfolyamat átvizsgálása szolgáltató vállalkozásoknak.',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Weboldal audit', 'Konverzióaudit', 'Ügyfélszerzési javítási terv'],
};

const problemData = {
  h1: 'Weboldal nem hoz ügyfelet? Nézzük meg, hol szakad meg a rendszer.',
  intro: 'Ha van forgalom, de nincs megkeresés, vagy hirdetsz és mégsem jön üzlet, ritkán egyetlen hibáról van szó. Lehet technikai, SEO-, ajánlati, mérési vagy UX-probléma. A cél nem egy hosszú hibalista, hanem annak megértése, hol folyik el az érdeklődő – és mit érdemes először javítani.',
  symptoms: [
    'Van forgalom, de kevés az ajánlatkérés vagy hívás',
    'Google Ads kattintások jönnek, de a landing nem konvertál',
    'Nem tudod, melyik csatornából lesz valódi lead',
    'Mobilon vagy lassú hálózaton gyenge az élmény',
    'Az ajánlat és a CTA nem egyértelmű az első képernyőn',
  ],
  causes: {
    title: 'Hol szokott elromlani az ügyfélszerzés',
    items: [
      'Keresési szándék és landing nincs összhangban',
      'Az ajánlat nem elég konkrét vagy túl későn derül ki, mit kap az ügyfél',
      'Technikai vagy mobilos súrlódás lassítja a kapcsolatfelvételt',
      'A CTA és az űrlap túl sok döntést vagy munkát kér',
      'GA4/GTM mérés nélkül nem látszik, melyik pont működik és melyik nem',
    ],
  },
  auditScope: {
    title: 'Mit nézünk meg az auditban',
    items: [
      'Technikai SEO, indexelés, canonical és alap crawl hibák',
      'Sebesség, mobil UX és Core Web Vitals kockázatok',
      'Első képernyő, ajánlat, bizalomépítés és CTA-struktúra',
      'Kapcsolatfelvételi út: űrlap, e-mail, telefon, üzenetküldés',
      'GA4/GTM és konverziós események megléte és logikája',
      'Hirdetési vagy organikus forgalom és landing közötti illeszkedés',
    ],
  },
  deliverables: {
    title: 'Mit kapsz a végén',
    items: [
      'Prioritásos probléma- és lehetőséglista üzleti hatás szerint',
      'Javítási sorrend: mi az az 1-3 lépés, ami először éri meg',
      'Konkrét landing/CTA/ajánlat javaslatok, nem általános tanácsok',
      'Mérési terv a valódi leadek elkülönítésére',
      'Technikai és SEO javítási pontok',
      'Megvalósítási opció: ha van értelme, a rendszert meg is tudjuk építeni',
    ],
  },
  faq: [
    {
      question: 'Mennyi idő alatt látszik eredmény?',
      answer: 'A technikai és konverziós javítások hatása gyakran gyorsan mérhető, a SEO több időt igényel. Előre nem ígérünk fix növekedést; azt határozzuk meg, mit és hogyan érdemes mérni.',
    },
    {
      question: 'Csak auditot kapok, vagy a javítást is megcsináljátok?',
      answer: 'Mindkettő lehetséges. Az audit után külön látod, mi a minimum javítás, és mi az a pont, ahol már érdemes komplett ügyfélszerző rendszert építeni.',
    },
    {
      question: 'Google Ads kampányt is meg lehet nézni?',
      answer: 'A landing és a konverziómérés szempontjából igen. A cél, hogy a kampánykattintás és a valódi érdeklődő között végig követhető legyen az út.',
    },
    {
      question: 'WordPress oldal is jöhet?',
      answer: 'Igen. Nem a technológia a kiindulópont, hanem az üzleti probléma. Ha a meglévő rendszer javítható, nem kell automatikusan újraépíteni.',
    },
    {
      question: 'Van garancia több leadre?',
      answer: 'Fix leadmennyiségre nem adható korrekt garancia. Arra viszont igen, hogy mérhetőbbé tesszük a folyamatot, és a javításokat valós adatok alapján priorizáljuk.',
    },
  ],
  cta: {
    title: 'Nézzük meg, hol szakad meg az ügyfélszerzés',
    subtitle: 'Írd meg röviden, milyen szolgáltatást értékesítesz és mi nem működik. Első körben azt keressük meg, mi a legkisebb értelmes javítás vagy rendszer, ami üzletileg előrelépést ad.',
  },
  relatedProblems: [
    {
      title: 'Lassú weboldal',
      url: '/lassu-weboldal/',
      description: 'PageSpeed, Core Web Vitals és technikai teljesítmény problémák',
    },
    {
      title: 'Google nem indexel',
      url: '/google-nem-indexel/',
      description: 'Indexelési és technikai SEO problémák feltárása',
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalURL}
  structuredData={structuredData}
>
  <MobileStickyBar client:idle />
  <HeaderAstro />
  <ProblemLandingPageV2 {...problemData} />
  <Footer />
  <CookieBanner client:load />
</BaseLayout>
