---
import { ArrowRight, Check, Database, Workflow } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro'; import HeaderAstro from '../components/HeaderAstro.astro'; import Footer from '../components/Footer'; import MobileStickyBar from '../components/MobileStickyBar'; import Contact from '../components/Contact'; import SubpageHero from '../components/SubpageHero.astro';
const structuredData={'@context':'https://schema.org','@type':'Service','name':'AI automatizálás, CRM és leadkezelés KKV-knak','provider':{'@type':'ProfessionalService','name':'Levente Studio','url':'https://leventestudio.app'},'areaServed':'HU'};
const uses=[['Lead rögzítés','A weboldalról vagy kampányból érkező érdeklődő automatikusan bekerül a kezelhető folyamatba.'],['Státusz és utánkövetés','Látható, kivel mi történt, hol tart az ajánlat és melyik megkeresés vár választ.'],['Értesítések és workflow','Az ismétlődő lépésekből automatizálható, ami nem igényel emberi döntést.'],['AI támogatás','AI-t ott használunk, ahol gyorsít: összefoglalás, előkészítés, osztályozás és adminisztratív segítség.']];
---
<BaseLayout title="AI automatizálás és CRM KKV-knak | Leadkezelés | Levente Studio" description="AI automatizálás, CRM és leadkezelés szolgáltató vállalkozásoknak. Kevesebb elveszett érdeklődő és manuális adminisztráció, átláthatóbb működés." canonical="/ai-automatizalas/" structuredData={structuredData}>
<MobileStickyBar/><HeaderAstro/><main class="bg-graphite-950 text-white"><SubpageHero eyebrow="AI automatizálás · CRM · leadkezelés" title="Ne az adminisztráció" accent="nőjön veled." description="A beérkező érdeklődőket, státuszokat és ismétlődő utánkövetést olyan rendszerbe szervezzük, amely csökkenti a kézi munkát és az elveszett megkeresések esélyét. Az AI eszköz, nem öncél." primaryHref="#automatizalas" primaryLabel="Mit automatizálunk?" secondaryHref="/kapcsolat/#diagnosztika" secondaryLabel="Ajánlatot kérek" meta={['750 000 Ft-tól','CRM / lead','Workflow','AI-assisted']} />
<section id="automatizalas" class="hightech-section bg-graphite-900"><div class="hightech-container"><div class="max-w-4xl mb-14"><Workflow className="w-6 h-6 text-signal-400 mb-5"/><h2 class="font-serif text-4xl sm:text-6xl font-light leading-[.94]">Előbb a folyamat. <span class="text-signal-400">Utána az automatizálás.</span></h2><p class="mt-6 text-lg text-white/55 leading-relaxed">Nem chatbotot vagy AI-t próbálunk rád erőltetni. Megnézzük, hol vész el idő, információ vagy érdeklődő, és csak azt automatizáljuk, aminek üzleti értelme van.</p></div><div class="grid md:grid-cols-2 gap-5">{uses.map(([t,d],i)=><article class="tech-card-dark p-7 min-h-[240px] flex flex-col"><div class="text-xs text-signal-400 tracking-[.18em]">AUTO/{String(i+1).padStart(2,'0')}</div><h3 class="font-serif text-3xl font-light mt-9">{t}</h3><p class="text-white/55 leading-relaxed mt-auto pt-6">{d}</p></article>)}</div></div></section>
<section class="hightech-section bg-graphite-950"><div class="hightech-container grid lg:grid-cols-2 gap-12"><div><Database className="w-6 h-6 text-signal-400 mb-5"/><h2 class="font-serif text-4xl sm:text-5xl font-light">Automatizált ügyfélkezelés <span class="text-signal-400">750 000 Ft-tól.</span></h2><p class="mt-6 text-white/55 leading-relaxed">Akkor éri meg, amikor már nem a weboldal a szűk keresztmetszet, hanem az, hogy a növekvő számú megkeresést követni, kezelni és utánkövetni kell.</p></div><div class="tech-card-dark p-7">{['Minden a komplett ügyfélszerző rendszerből','CRM vagy lead dashboard','Automatikus státuszok és értesítések','E-mail / workflow automatizálás','AI-támogatott belső folyamatok','Egyedi dashboard és integrációk','90 nap optimalizálás'].map(x=><div class="flex gap-3 border-b border-white/10 py-3 text-white/70"><Check className="w-4 h-4 text-signal-400 shrink-0 mt-0.5"/><span>{x}</span></div>)}<a href="/kapcsolat/#diagnosztika" class="signal-button-primary mt-7 inline-flex">Mutasd meg a folyamatot <ArrowRight className="w-4 h-4"/></a></div></div></section><div id="kapcsolat"><Contact/></div></main><Footer/></BaseLayout>