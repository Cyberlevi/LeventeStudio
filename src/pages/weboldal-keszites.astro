---
import { ArrowRight, Check, Gauge } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro'; import HeaderAstro from '../components/HeaderAstro.astro'; import Footer from '../components/Footer'; import MobileStickyBar from '../components/MobileStickyBar'; import Contact from '../components/Contact'; import SubpageHero from '../components/SubpageHero.astro'; import { studioOffers } from '../data/studio-offers';
const offer = studioOffers.find((item) => item.id === 'START')!;
const benefits=[['01','Ajánlat, nem digitális névjegykártya','Az oldal első feladata, hogy néhány másodperc alatt érthetővé tegye, mit adsz, kinek és miért érdemes téged választani.'],['02','Keresőbarát alap','Technikai SEO, strukturált tartalom és olyan oldalstruktúra, amelyre később szolgáltatási landingek és tartalom építhető.'],['03','Mérhető érdeklődők','GA4 és leadmérés: ne csak látogatószámot láss, hanem azt is, melyik forrásból érkezik kapcsolatfelvétel.']];
const structuredData={'@context':'https://schema.org','@type':'Service','name':'Ügyfélszerző weboldal készítés','provider':{'@type':'ProfessionalService','name':'Levente Studio','url':'https://leventestudio.app'},'areaServed':'HU'};
---
<BaseLayout title="Weboldal készítés vállalkozásoknak | Ügyfélszerző weboldal | Levente Studio" description="Gyors, keresőbarát és mérhető weboldal szolgáltató vállalkozásoknak. Nem csak jól néz ki: ajánlatkérésre és későbbi ügyfélszerzésre épül." canonical="/weboldal-keszites/" structuredData={structuredData}><MobileStickyBar/><HeaderAstro/><main class="bg-graphite-950 text-white"><SubpageHero eyebrow="Weboldal készítés · szolgáltató vállalkozásoknak" title="Ne csak legyen weboldalad." accent="Dolgozzon is érted." description="Gyors, keresőbarát és mérhető ügyfélszerző weboldalt építünk. Világos ajánlat, erős mobilélmény, leadmérés és olyan technikai alap, amelyre később SEO és hirdetés is biztonsággal építhető." primaryHref="#mit-kapsz" primaryLabel="Mit kapsz?" secondaryHref="/kapcsolat/?csomag=START#diagnosztika" secondaryLabel="Ajánlatot kérek" meta={[offer.price,'Mobil-first','SEO alap','Leadmérés']}/>
<section id="mit-kapsz" class="hightech-section bg-graphite-900 relative overflow-hidden"><div class="absolute inset-0 studio-grid-dark opacity-20"></div><div class="hightech-container relative"><div class="max-w-4xl mb-14"><div class="text-xs uppercase tracking-[0.18em] text-signal-400 mb-4">Üzleti weboldal</div><h2 class="font-serif text-4xl sm:text-6xl font-light leading-[.94]">A weboldal ára önmagában semmit nem mond. <span class="text-signal-400">Az számít, mit tud elvégezni.</span></h2><p class="mt-6 text-lg text-white/55 font-light leading-relaxed">Egy egyszerű bemutatkozó oldal és egy üzletileg használható szolgáltatói weboldal nem ugyanaz. Itt az ajánlat, a kapcsolatfelvétel, a technikai SEO, a mérés és a bővíthető struktúra együtt készül.</p></div><div class="grid md:grid-cols-3 gap-5">{benefits.map(([n,t,d])=><article class="tech-card-dark p-7 min-h-[280px] flex flex-col"><div class="text-xs text-signal-400 tracking-[.18em]">{n}</div><h3 class="font-serif text-3xl font-light mt-10">{t}</h3><p class="text-white/55 text-sm leading-relaxed mt-auto pt-6">{d}</p></article>)}</div></div></section>
<section class="hightech-section bg-signal-400 text-graphite-950"><div class="hightech-container grid lg:grid-cols-[.72fr_1.28fr] gap-10 lg:gap-16 items-center"><div><div class="text-[10px] uppercase tracking-[.2em] opacity-60 mb-4">Valós saját projekt · Klima18ker</div><h2 class="font-serif text-4xl sm:text-5xl font-light leading-[.95]">Nem csak ügyfeleknek mondjuk, hogy így kell építeni. <span class="opacity-60">Mi is így használjuk.</span></h2></div><div class="bg-graphite-950 text-white p-7 md:p-9"><div class="grid sm:grid-cols-3 gap-px bg-white/10 mb-7"><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">LIVE</div><div class="text-xs text-white/50 mt-1">valós szolgáltatás</div></div><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">SEO + SPEED</div><div class="text-xs text-white/50 mt-1">technikai alap</div></div><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">GA4 → LEAD</div><div class="text-xs text-white/50 mt-1">mérhető út</div></div></div><p class="text-white/60 leading-relaxed">A Klima18ker éles klímaszolgáltatás: a webes struktúrát valódi ügyfélkérdések, helyi keresési szándék és kapcsolatfelvételi tapasztalat alapján fejlesztjük tovább.</p><a href="/esettanulmanyok/klima18ker-weboldal-audit/" data-track-cta="Klima18ker proof" data-track-location="weboldal_proof" class="inline-flex items-center gap-2 mt-6 text-signal-400">Megnézem az esettanulmányt <ArrowRight className="w-4 h-4"/></a></div></div></section>
<section class="hightech-section bg-graphite-950"><div class="hightech-container grid lg:grid-cols-2 gap-12 items-start"><div><Gauge className="w-6 h-6 text-signal-400 mb-5"/><h2 class="font-serif text-4xl sm:text-5xl font-light">Weboldal a szolgáltatásaidhoz <span class="text-signal-400">{offer.price}.</span></h2><p class="mt-6 text-white/55 leading-relaxed">Jó belépő annak, akinek most kell rendbe tenni az online alapot. Ha már aktívan szeretnél Google-ből vagy hirdetésből ügyfelet szerezni, a GROW csomag a következő szint.</p></div><div class="tech-card-dark p-7">{offer.features.map(x=><div class="flex gap-3 border-b border-white/10 py-3 text-white/70"><Check className="w-4 h-4 text-signal-400 shrink-0 mt-0.5"/><span>{x}</span></div>)}<a href="/kapcsolat/?csomag=START#diagnosztika" data-track-cta="Ajánlatot kérek - START" data-track-location="weboldal_package" class="signal-button-primary mt-7 inline-flex">Ajánlatot kérek <ArrowRight className="w-4 h-4"/></a></div></div></section><div id="kapcsolat"><Contact/></div></main><Footer/></BaseLayout>