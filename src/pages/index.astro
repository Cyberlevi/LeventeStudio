---
let raw = '';
let parsed: any = null;
let error = '';

try {
  const response = await fetch('https://leventestudio.app/diagnosztika-lighthouse/', {
    headers: { accept: 'text/html' },
  });
  raw = await response.text();

  const match = raw.match(/<pre>([\s\S]*?)<\/pre>/i);
  if (!match) {
    error = `No <pre> payload. HTTP ${response.status}. Body: ${raw.slice(0, 1200)}`;
  } else {
    const decoded = match[1]
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&amp;/g, '&');

    parsed = JSON.parse(decoded);
  }
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const accessibility = parsed?.accessibility ?? [];
const bestPractices = parsed?.bestPractices ?? [];
---
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Lighthouse screenshot diagnostic</title>
    <style>
      body { margin:0; padding:32px; background:#0b0d0c; color:#f4f0e8; font-family:Arial,sans-serif; }
      h1 { color:#d8ff78; font-size:40px; margin:0 0 24px; }
      h2 { color:#d8ff78; font-size:28px; margin:28px 0 10px; }
      .score { font-size:24px; margin-bottom:16px; }
      .audit { border:1px solid #394038; padding:16px; margin:12px 0; }
      .title { font-size:22px; font-weight:700; }
      .id { color:#aab0a8; font-family:monospace; margin-top:4px; }
      .item { margin-top:10px; padding-top:10px; border-top:1px solid #2b302b; font-family:monospace; font-size:15px; white-space:pre-wrap; }
      .error { color:#ffb4b4; white-space:pre-wrap; font-size:18px; }
    </style>
  </head>
  <body>
    <h1>Lighthouse diagnosztika</h1>
    {parsed ? (
      <>
        <div class="score">Accessibility: {parsed?.scores?.accessibility} · Best Practices: {parsed?.scores?.bestPractices}</div>
        <h2>Accessibility bukások</h2>
        {accessibility.length === 0 ? <p>Nincs súlyozott bukó audit.</p> : accessibility.map((audit:any) => (
          <div class="audit">
            <div class="title">{audit.title}</div>
            <div class="id">{audit.id} · score {audit.score}</div>
            {(audit.items ?? []).slice(0,4).map((item:any) => (
              <div class="item">{item?.node?.selector || item?.node?.snippet || item?.url || item?.source || JSON.stringify(item)}</div>
            ))}
          </div>
        ))}
        <h2>Best Practices bukások</h2>
        {bestPractices.length === 0 ? <p>Nincs súlyozott bukó audit.</p> : bestPractices.map((audit:any) => (
          <div class="audit">
            <div class="title">{audit.title}</div>
            <div class="id">{audit.id} · score {audit.score}</div>
            {(audit.items ?? []).slice(0,4).map((item:any) => (
              <div class="item">{item?.node?.selector || item?.node?.snippet || item?.url || item?.source || JSON.stringify(item)}</div>
            ))}
          </div>
        ))}
      </>
    ) : <div class="error">{error || raw.slice(0,2000)}</div>}
  </body>
</html>
