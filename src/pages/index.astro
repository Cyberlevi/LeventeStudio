---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Hero2026 from '../components/Hero2026';
import StudioLab from '../components/StudioLab';
import ProblemAwareness2026 from '../components/ProblemAwareness2026';
import Pricing2026 from '../components/Pricing2026';
import ProjectProcess from '../components/ProjectProcess';
import LeadDiagnostic from '../components/LeadDiagnostic.astro';
import FAQ2026 from '../components/FAQ2026';
import Contact2026 from '../components/Contact2026';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar2026 from '../components/MobileStickyBar2026';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Levente Studio',
  description: 'Weboldalkészítés szolgáltató vállalkozásoknak. Tervezés, fejlesztés, mérés és weboldalgondozás.',
  url: 'https://leventestudio.app/', image: 'https://leventestudio.app/levente_studio_portrait_final.webp',
  logo: 'https://leventestudio.app/android-chrome-512x512.png', areaServed: 'HU',
  provider: { '@type': 'Person', name: 'Tarnóczi Levente', email: 'hello@leventestudio.app' },
  serviceType: ['Weboldalkészítés', 'Weboldalgondozás', 'Konverziómérés', 'Üzleti automatizálás'],
};
---
<BaseLayout title="Weboldalkészítés szolgáltatóknak | Levente Studio" description="Profi weboldal, bemutatható munkák és egyszerű ajánlatkérés. Saját projekteken szerzett tapasztalattal, közvetlen együttműködésben. Csomagok 149 000 Ft-tól." canonical="/" structuredData={structuredData}>
  <CookieBanner client:load /><HeaderAstro /><MobileStickyBar2026 />
  <main><Hero2026 /><StudioLab /><ProblemAwareness2026 /><Pricing2026 /><ProjectProcess /><FAQ2026 /><LeadDiagnostic /><Contact2026 /></main>
  <Footer />
</BaseLayout>
