---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Hero2026 from '../components/Hero2026';
import StudioLab from '../components/StudioLab';
import TrustBar from '../components/TrustBar';
import ProblemAwareness from '../components/ProblemAwareness';
import Solution from '../components/Solution';
import Pricing from '../components/Pricing';
import LeadDiagnostic from '../components/LeadDiagnostic.astro';
import FAQ from '../components/FAQ';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';
import StickyDesktopCTA from '../components/StickyDesktopCTA';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Levente Studio - AI-native digitális növekedési rendszerek',
  'description': 'Weboldal, SEO, mérés, automatizálás és ügyfélszerző rendszerek szolgáltató vállalkozásoknak.',
  'image': 'https://leventestudio.app/logo.png',
  'logo': { '@type': 'ImageObject', 'url': 'https://leventestudio.app/logo.png', 'width': 512, 'height': 512 },
  'provider': {
    '@type': 'Person',
    'name': 'Tarnóczi Levente',
    'jobTitle': 'Digitális rendszerépítő',
    'email': 'hello@leventestudio.app',
    'url': 'https://leventestudio.app',
    'image': 'https://leventestudio.app/levente_studio_portrait_final.webp'
  },
  'areaServed': 'HU',
  'serviceType': ['Ügyfélszerző weboldal', 'SEO optimalizálás', 'Konverziómérés', 'Lead rendszer', 'Üzleti automatizálás', 'AI workflow'],
  'address': { '@type': 'PostalAddress', 'addressCountry': 'HU' },
  'priceRange': '$$'
};
---

<BaseLayout
  title="AI-native ügyfélszerző rendszerek vállalkozásoknak | Levente Studio"
  description="Weboldal, SEO, mérés és automatizálás egy rendszerben. AI-native digitális ügyfélszerzés szolgáltató vállalkozásoknak, saját éles projekteken tesztelt módszerekkel."
  canonical="/"
  structuredData={structuredData}
>
  <CookieBanner client:load />
  <MobileStickyBar client:load />
  <StickyDesktopCTA client:load />

  <div class="min-h-screen bg-graphite-950">
    <HeaderAstro />
    <Hero2026 client:load />
    <TrustBar />
    <StudioLab />
    <ProblemAwareness />
    <Solution />
    <LeadDiagnostic />
    <Pricing client:load />
    <FAQ client:load />
    <Contact client:load />
    <Footer />
  </div>
</BaseLayout>
