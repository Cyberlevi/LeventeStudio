---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import AboutExpertDark from '../components/AboutExpertDark';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Tarnóczi Levente',
  'jobTitle': 'Digitális rendszerépítő',
  'email': 'hello@leventestudio.app',
  'url': 'https://leventestudio.app/rolam/',
  'image': 'https://leventestudio.app/levente_studio_portrait_final.webp',
  'worksFor': { '@type': 'ProfessionalService', 'name': 'Levente Studio', 'url': 'https://leventestudio.app' },
  'knowsAbout': ['Webfejlesztés','SEO','Google Ads mérés','Webanalitika','Lead management','AI workflow','Üzleti automatizálás']
};
---

<BaseLayout
  title="Rólam – Tarnóczi Levente, digitális rendszerépítő | Levente Studio"
  description="A Levente Studio mögötti rendszerépítő szemlélet: web, SEO, Ads mérés, leadkezelés és AI-assisted működés saját éles projekteken tesztelve."
  canonical="/rolam/"
  structuredData={structuredData}
>
  <CookieBanner client:load />
  <MobileStickyBar client:idle />
  <div class="min-h-screen bg-graphite-950"><HeaderAstro /><AboutExpertDark /><Footer /></div>
</BaseLayout>
