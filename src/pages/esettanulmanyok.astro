---
import { ArrowRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';

const projects = [
  {
    category: 'Klímatechnika',
    title: 'Klima18ker',
    subtitle: 'Web + SEO + technikai optimalizálás',
    description: 'Egy helyi klímaszolgáltatás digitális jelenlétének gyorsítása, keresőbarát struktúrája és mérhetőbb működése.',
    href: '/esettanulmanyok/klima18ker-weboldal-audit/',
    tags: ['SEO', 'performance', 'local service']
  },
  {
    category: 'Építőipari szolgáltatás',
    title: 'FuratMester',
    subtitle: 'Landing + Google Ads + lead funnel',
    description: 'Speciális faláttörési szolgáltatásra épített rendszer, ahol a keresési szándék, az ajánlat, a hirdetés és a leadmérés egy láncot alkot.',
    href: '/esettanulmanyok/furatmester-digitalis-ugyfelszerzes/',
    tags: ['landing', 'Ads', 'GA4/GTM']
  },
  {
    category: 'Helyi szolgáltatás',
    title: 'Bundavarázs',
    subtitle: 'Local presence + mérési alapok',
    description: 'Kutyakozmetikai jelenlét, ahol a mobil ügyfélút, a helyi Google-jelenlét és az analitika dolgozik együtt.',
    href: '/esettanulmanyok/bundavarazs-helyi-ugyfelszerzes/',
    tags: ['local SEO', 'Google Business', 'GA4']
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': 'Levente Studio Lab – valós digitális rendszerek',
  'description': 'Valós szolgáltatói projektek webfejlesztési, SEO, mérési és ügyfélszerzési tapasztalatokkal.',
  'url': 'https://leventestudio.app/esettanulmanyok/',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app'
  }
};
---

<BaseLayout
  title="Levente Studio Lab – valós ügyfélszerző rendszerek és esettanulmányok"
  description="Klíma, faláttörés és helyi szolgáltatás: valós projektek, amelyeken webet, SEO-t, mérést, Ads funnel-t és digitális működést építünk és tesztelünk."
  canonical="/esettanulmanyok/"
  structuredData={structuredData}
>
  <CookieBanner client:load />
  <MobileStickyBar client:load />

  <div class="min-h-screen bg-white">
    <HeaderAstro />

    <main>
      <section class="pt-36 pb-20 px-6 bg-cream-50 border-b border-taupe-100">
        <div class="max-w-6xl mx-auto">
          <p class="text-sm uppercase tracking-[0.18em] text-taupe-500 mb-5">Levente Studio Lab</p>
          <h1 class="font-serif text-5xl md:text-6xl font-light text-taupe-900 max-w-4xl leading-tight mb-7">
            Nem portfóliót mutatunk. <span class="text-taupe-600">Működő rendszereket.</span>
          </h1>
          <p class="text-xl text-taupe-700 font-light leading-relaxed max-w-3xl">
            Ezeken a projekteken valós keresések, kampányok, ajánlatkérések és üzleti döntések futnak. Itt teszteljük azt, amit később más vállalkozások rendszerébe is beépítünk.
          </p>
        </div>
      </section>

      <section class="py-24 px-6 bg-white">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-6">
          {projects.map((project) => (
            <article class="border border-taupe-200 bg-white p-7 flex flex-col">
              <p class="text-xs uppercase tracking-[0.16em] text-taupe-500 mb-4">{project.category}</p>
              <h2 class="text-3xl text-taupe-900 mb-2">{project.title}</h2>
              <p class="text-taupe-600 mb-5">{project.subtitle}</p>
              <p class="text-taupe-700 font-light leading-relaxed mb-7 flex-1">{project.description}</p>

              <div class="flex flex-wrap gap-2 mb-7">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs rounded-full bg-taupe-50 border border-taupe-200 text-taupe-600">{tag}</span>
                ))}
              </div>

              <a href={project.href} class="inline-flex items-center gap-2 text-taupe-900 border-b border-taupe-300 pb-1 self-start hover:border-taupe-900 transition-colors">
                Esettanulmány
                <ArrowRight className="w-4 h-4" />
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="py-20 px-6 bg-taupe-900 text-cream-50">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-10">
          <div>
            <div class="text-4xl mb-3">01</div>
            <h2 class="text-xl mb-2">Saját kockázat</h2>
            <p class="text-cream-200 font-light">A saját rendszereinknél a rossz döntés nem prezentációs hiba, hanem üzleti következmény. Ez másfajta fegyelmet ad.</p>
          </div>
          <div>
            <div class="text-4xl mb-3">02</div>
            <h2 class="text-xl mb-2">Valós visszajelzés</h2>
            <p class="text-cream-200 font-light">A leadek, a keresési adatok és az ügyfélkérdések megmutatják, hol nem elég világos az ajánlat vagy a folyamat.</p>
          </div>
          <div>
            <div class="text-4xl mb-3">03</div>
            <h2 class="text-xl mb-2">Folyamatos iteráció</h2>
            <p class="text-cream-200 font-light">A rendszer nem készül el egyszer és örökre. Mérjük, javítjuk, egyszerűsítjük, majd újra mérjük.</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
