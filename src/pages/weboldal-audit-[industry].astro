---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';
import Contact from '../components/Contact';
import { industries, type Industry } from '../data/industries';

export async function getStaticPaths() {
  return industries.map((industry) => ({
    params: { industry: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;
const title = `Weboldal audit és ügyfélszerzési rendszer ${industry.namePlural} számára | Levente Studio`;
const description = `${industry.namePlural} digitális rendszerdiagnózisa: weboldal, SEO, konverzió, mérés és kapcsolatfelvételi folyamat egyben.`;
const canonical = `/weboldal-audit-${industry.slug}/`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': `Weboldal audit és digitális rendszerdiagnózis ${industry.namePlural} számára`,
  'description': description,
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Levente Studio',
    'url': 'https://leventestudio.app',
  },
  'areaServed': 'HU',
  'serviceType': ['Weboldal audit', 'SEO diagnózis', 'Konverzióoptimalizálás', 'Digitális rendszerterv'],
};
---

<BaseLayout title={title} description={description} canonical={canonical} structuredData={structuredData}>
  <MobileStickyBar client:load />
  <HeaderAstro />

  <main>
    <section class="pt-36 pb-20 px-6 bg-cream-50 relative overflow-hidden">
      <div class="absolute inset-0 studio-grid pointer-events-none"></div>
      <div class="max-w-5xl mx-auto relative">
        <div class="studio-kicker text-taupe-500 mb-5">Iparági rendszerdiagnózis · 2026</div>
        <h1 class="font-serif text-5xl md:text-7xl font-light text-taupe-900 leading-[0.98] mb-7 max-w-4xl">
          Weboldal audit és ügyfélszerző rendszer
          <span class="block text-taupe-600">{industry.namePlural} számára.</span>
        </h1>
        <p class="text-xl text-taupe-700 font-light leading-relaxed max-w-3xl mb-9">
          Nem egy általános hibajegyzéket készítünk. A {industry.name.toLowerCase()} vállalkozás ügyfélszerzési útját nézzük végig: hogyan találnak rád, mit látnak az oldalon, hol lépnek kapcsolatba és mit tudsz ebből mérni.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#kapcsolat" class="inline-flex items-center justify-center px-8 py-4 bg-taupe-900 text-cream-50 rounded-sm hover:bg-taupe-800 transition-colors">
            Beszéljük át a rendszert
          </a>
          <a href="/esettanulmanyok/" class="inline-flex items-center justify-center px-8 py-4 border border-taupe-300 bg-white/60 text-taupe-800 rounded-sm hover:bg-white transition-colors">
            Valós rendszereink
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-white">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-12">
        <div>
          <div class="studio-kicker text-taupe-500 mb-4">Tipikus súrlódások</div>
          <h2 class="font-serif text-4xl md:text-5xl font-light text-taupe-900 text-balance">
            Ezeket a pontokat érdemes először ellenőrizni.
          </h2>
        </div>
        <div class="grid gap-4">
          {industry.painPoints.map((painPoint) => (
            <div class="studio-card border-taupe-200 bg-taupe-50/50 p-5 text-taupe-700">
              {painPoint}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-cream-50">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-3xl mb-12">
          <div class="studio-kicker text-taupe-500 mb-4">Mit vizsgálunk</div>
          <h2 class="font-serif text-4xl md:text-5xl font-light text-taupe-900 mb-5">
            A weboldalt nem külön kezeljük az ügyfélszerzéstől.
          </h2>
          <p class="text-lg text-taupe-700 font-light">
            Az iparági sajátosságok mellett mindig megnézzük a keresési jelenlétet, a mobil élményt, az ajánlatot, a CTA-kat és a mérési rendszert is.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          {industry.benefits.map((benefit) => (
            <div class="studio-card border-taupe-200 bg-white p-6 text-taupe-800">
              {benefit}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 px-6 bg-taupe-900 text-cream-50">
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-8">
        <div class="border-t border-taupe-700 pt-5">
          <div class="text-sm text-cream-400 mb-4">01</div>
          <h3 class="text-xl mb-2">Diagnózis</h3>
          <p class="text-cream-200 font-light">Megkeressük, hol van a legnagyobb üzleti és technikai súrlódás.</p>
        </div>
        <div class="border-t border-taupe-700 pt-5">
          <div class="text-sm text-cream-400 mb-4">02</div>
          <h3 class="text-xl mb-2">Prioritás</h3>
          <p class="text-cream-200 font-light">Nem mindent javítunk egyszerre. A várható hatás alapján sorrendet rakunk.</p>
        </div>
        <div class="border-t border-taupe-700 pt-5">
          <div class="text-sm text-cream-400 mb-4">03</div>
          <h3 class="text-xl mb-2">Megvalósítás + mérés</h3>
          <p class="text-cream-200 font-light">A fontos javításokat megépítjük, majd visszamérjük, mi változott.</p>
        </div>
      </div>
    </section>

    <Contact client:load />
  </main>

  <Footer />
  <CookieBanner client:load />
</BaseLayout>
