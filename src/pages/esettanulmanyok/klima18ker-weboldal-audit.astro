---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemCaseStudy from '../../components/SystemCaseStudy.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': 'Klima18ker – web, SEO és mérési rendszer esettanulmány',
  'description': 'Helyi klímaszolgáltatás webes rendszerének modernizálása, keresési struktúrája, technikai SEO-ja és mérési alapjai.',
  'author': { '@type': 'Organization', 'name': 'Levente Studio' }
};
---

<BaseLayout
  title="Klima18ker esettanulmány – web, SEO és mérés | Levente Studio"
  description="Hogyan épül fel egy helyi klímaszolgáltatás digitális rendszere: gyors web, technikai SEO, helyi keresési struktúra és mérhető kapcsolatfelvétel."
  canonical="/esettanulmanyok/klima18ker-weboldal-audit/"
  ogType="article"
  structuredData={structuredData}
>
  <SystemCaseStudy
    eyebrow="Levente Studio Lab · klímatechnika"
    title="Klima18ker: helyi szolgáltatói weboldalból mérhető digitális rendszer"
    lead="A Klima18ker nem bemutató projekt, hanem működő helyi szolgáltatás. A weboldal feladata ezért nem pusztán az információközlés: gyorsnak, kereshetőnek, mobilon egyszerűnek és mérhetőnek kell lennie, miközben a valós ügyfélkérdésekhez igazodik."
    stack={['Astro', 'technical SEO', 'local SEO', 'GA4', 'performance', 'conversion tracking']}
    sections={[
      {
        title: 'A kiinduló cél',
        body: 'Egy klímaszolgáltatás weboldalán a felhasználó jellemzően konkrét igénnyel érkezik: készüléket, telepítést, karbantartást vagy műszaki információt keres. Az oldalnak gyorsan el kell döntenie, melyik tartalom és CTA segíti tovább, és közben a Google számára is egyértelmű szolgáltatási struktúrát kell adnia.'
      },
      {
        title: 'Modernizált technikai alap',
        body: 'A rendszer fókusza a gyors, karbantartható frontend, a technikai SEO, a helyes meta- és strukturált adatok, valamint a mobil használhatóság. A cél nem egy PageSpeed pontszám önmagáért, hanem hogy a technikai réteg ne akadályozza sem a látogatót, sem a keresőrobotot.'
      },
      {
        title: 'Mérés és üzleti visszacsatolás',
        body: 'A webes események és a kapcsolatfelvételi pontok mérése azért fontos, mert így a tartalmi és marketingdöntések nem kizárólag megérzésből születnek. A projektből szerzett tapasztalatokat más helyi szolgáltatói rendszerek felépítésénél is felhasználjuk.'
      }
    ]}
    built={[
      'modern, gyors webes frontend',
      'technikai SEO és indexelési alapok',
      'helyi szolgáltatási információs struktúra',
      'mobil-first kapcsolatfelvételi út',
      'GA4 és konverziós mérési alapok',
      'folyamatos technikai és tartalmi finomítás'
    ]}
    lessons={[
      'Helyi szolgáltatásnál a keresési szándékot és a szolgáltatási struktúrát együtt kell kezelni.',
      'A gyors oldal akkor érték, ha közben az ajánlat és a következő lépés is egyértelmű.',
      'A technikai SEO nem egyszeri ellenőrzőlista: deploy, tartalom és új landing oldal is visszahathat rá.',
      'A saját éles projektből származó ügyfélkérdések sokszor jobb tartalmi roadmapet adnak, mint egy elméleti kulcsszólista.'
    ]}
    liveUrl="https://klima18ker.hu"
  />
</BaseLayout>
