---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemCaseStudy from '../../components/SystemCaseStudy.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': 'FuratMester – digitális ügyfélszerző rendszer esettanulmány',
  'description': 'Landing page, Google Ads mérés, lead funnel és konverzióoptimalizálás egy speciális építőipari szolgáltatáshoz.',
  'author': { '@type': 'Organization', 'name': 'Levente Studio' }
};
---

<BaseLayout
  title="FuratMester esettanulmány – landing, Ads és lead funnel | Levente Studio"
  description="Hogyan épül fel egy speciális helyi szolgáltatás digitális ügyfélszerző rendszere: landing page, Google Ads mérés, ajánlatstruktúra és leadkövetés."
  canonical="/esettanulmanyok/furatmester-digitalis-ugyfelszerzes/"
  structuredData={structuredData}
>
  <SystemCaseStudy
    eyebrow="Levente Studio Lab · építőipari szolgáltatás"
    title="FuratMester: a kereséstől az ajánlatkérésig mérhető rendszer"
    lead="Egy speciális szolgáltatásnál nem elég, hogy szép legyen az oldal. Az érdeklődőnek azonnal értenie kell, mit kap, a hirdetésnek a megfelelő oldalra kell vinnie, a leadet pedig mérni kell. A FuratMesternél ezt a teljes utat egy rendszerként építettük fel."
    stack={['Astro', 'Google Ads', 'GA4', 'GTM', 'SEO', 'lead tracking']}
    sections={[
      {
        title: 'A kiinduló helyzet',
        body: 'A faláttörés és páraelszívó-kivezetés tipikusan olyan szolgáltatás, amelyre akkor keresnek rá, amikor konkrét munka van. Ez erős vásárlási szándékot jelent, de az ajánlatot gyorsan és egyértelműen kell kommunikálni: furatméret, falanyag, kiegészítők, kiszállás és a komplett kivitelezés tartalma.'
      },
      {
        title: 'A rendszer logikája',
        body: 'A landing oldalak nem általános céges bemutatkozásként működnek. Egy konkrét problémára adnak választ, majd az érdeklődőt ajánlatkérés felé terelik. A Google Ads és az analitika ugyanahhoz a funnelhez kapcsolódik, ezért láthatóvá válik, melyik keresésből, oldalból és CTA-ból lesz valódi lead.'
      },
      {
        title: 'Folyamatos optimalizálás',
        body: 'A rendszer nem az átadáskor ér véget. Az ajánlatok, árstruktúrák, kizáró kulcsszavak, landing szövegek és konverziós események az éles megkeresések alapján finomíthatók. Ez a működés adja a Levente Studio rendszerépítő szemléletének egyik legerősebb gyakorlati alapját.'
      }
    ]}
    built={[
      'szolgáltatás-specifikus landing struktúra',
      'SEO és keresési szándék szerinti tartalom',
      'Google Ads-ready mérési környezet',
      'GA4/GTM lead események',
      'ajánlatkérési CTA és funnel logika',
      'folyamatos ár- és konkurencia-visszamérés'
    ]}
    lessons={[
      'Niche szolgáltatásnál a konkrét ajánlat és a keresési szándék fontosabb, mint a sok általános céges tartalom.',
      'A hirdetés csak akkor optimalizálható jól, ha a valódi lead külön eseményként mérhető.',
      'Az ár önmagában kevés: a csomag tartalma és az ügyfél által megspórolt szervezés is része az értékajánlatnak.',
      'A landing, az Ads és az ajánlatadási folyamat együtt ad értelmezhető üzleti képet.'
    ]}
    liveUrl="https://lyukfurasbudapest.hu"
  />
</BaseLayout>
