 sections={[
  {title:'01. A kereslet már létezett',body:'A faláttörés és páraelszívó-kivezetés tipikusan problématudatos keresés. Az érdeklődő nem inspirációt keres: konkrét munkát akar megoldani. A weboldal első feladata ezért nem a cég hosszú bemutatása, hanem a keresési szándék gyors és pontos kiszolgálása.'},
  {title:'02. Termékké tettük a szolgáltatást',body:'A furat önmagában nehezen összehasonlítható ajánlat. A kommunikáció ezért a komplett megoldás felé épül: furat, falátvezetés, visszacsapás, külső lezárás és a szükséges kapcsolódó elemek. Így az ár mögött láthatóvá válik az érték és csökken a puszta árverseny.'},
  {title:'03. A landing és a hirdetés ugyanazt az ígéretet viszi tovább',body:'A keresési kulcsszó, a hirdetési üzenet és a céloldal nem három külön projekt. Egy ügyfélút részei. A látogató azt kapja a landingen, amit a keresés és a hirdetés alapján várt, majd egyértelmű ajánlatkérési útvonalon tud továbbmenni.'},
  {title:'04. A lead visszakerül a mérésbe',body:'GA4 és GTM eseményekkel elkülöníthető a puszta látogatás az üzletileg fontos műveletektől. Így nem a kattintás a végpont: azt akarjuk látni, melyik forrás, landing és CTA hoz tényleges megkeresést.'},
  {title:'05. Az éles működésből tanulunk',body:'Az ajánlatok, árstruktúra, kizáró kulcsszavak, landing szövegek és konverziós pontok nem véglegesek. A valós érdeklődésekből származó tapasztalat visszakerül a fejlesztési folyamatba. Ez az a működési ciklus, amit a Levente Studio más szolgáltató vállalkozásoknál is alkalmaz.'}
 ]}
 built={['keresési szándékra épített szolgáltatási landingek','komplett ajánlat- és értékstruktúra','SEO + Google Ads keresletfogás','GA4 / GTM lead események','forrás → landing → CTA → lead mérési logika','ár- és konkurencia-visszamérés','folyamatos CRO iteráció']}
