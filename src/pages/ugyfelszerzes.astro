---
import { ArrowRight, Check, BarChart3, Target } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro'; import HeaderAstro from '../components/HeaderAstro.astro'; import Footer from '../components/Footer'; import MobileStickyBar from '../components/MobileStickyBar'; import Contact from '../components/Contact'; import SubpageHero from '../components/SubpageHero.astro';
const structuredData={'@context':'https://schema.org','@type':'Service','name':'Digitális ügyfélszerző rendszer szolgáltató vállalkozásoknak','provider':{'@type':'ProfessionalService','name':'Levente Studio','url':'https://leventestudio.app'},'areaServed':'HU'};
const flow=[['01','Kereslet','Kulcsszó- és konkurenciakutatással azt fogjuk meg, amire a potenciális ügyfél ténylegesen keres.'],['02','Landing és ajánlat','A látogató nem a főoldalon bolyong: az adott problémára épített ajánlatot és következő lépést kap.'],['03','Mérés','GA4, GTM és lead események mutatják, melyik csatorna és landing hoz valódi érdeklődőt.'],['04','Javítás','A működésből származó adatok alapján finomítjuk az ajánlatot, CTA-t, landinget és kampányt.']];
---
<BaseLayout title="Ügyfélszerzés vállalkozásoknak | Google, landing és mérés | Levente Studio" description="Komplett digitális ügyfélszerző rendszer szolgáltató vállalkozásoknak: keresletkutatás, landing, SEO, Ads-ready mérés és lead funnel egyben." canonical="/ugyfelszerzes/" structuredData={structuredData}><MobileStickyBar client:idle/><HeaderAstro/><main class="bg-graphite-950 text-white"><SubpageHero eyebrow="GROW · ügyfélszerzés · Google · landing · mérés" title="Ne kattintást vegyél." accent="Érdeklődőt szerezz." description="A weboldalt, a keresési szándékot, a landingeket és a konverziómérést egy rendszerbe kötjük. Így nem az a kérdés, hányan jártak az oldalon, hanem hogy honnan érkezett a valódi megkeresés." primaryHref="#rendszer" primaryLabel="Hogyan működik?" secondaryHref="/kapcsolat/#diagnosztika" secondaryLabel="2 perces diagnózis" meta={['450–650 000 Ft','Search intent','Ads-ready','Lead tracking']}/>
<section id="rendszer" class="hightech-section bg-graphite-900 relative"><div class="hightech-container"><div class="max-w-4xl mb-14"><Target className="w-6 h-6 text-signal-400 mb-5"/><h2 class="font-serif text-4xl sm:text-6xl font-light leading-[.94]">A hirdetés önmagában <span class="text-signal-400">nem ügyfélszerző rendszer.</span></h2><p class="mt-6 text-lg text-white/55 leading-relaxed">Ha a keresési szándék, az ajánlat, a landing és a mérés nincs összekötve, könnyű kattintásra költeni úgy, hogy közben nem tudod, mi termel üzletet.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">{flow.map(([n,t,d])=><article class="tech-card-dark p-6 min-h-[280px] flex flex-col"><div class="text-xs text-signal-400 tracking-[.18em]">{n}</div><h3 class="font-serif text-3xl font-light mt-10">{t}</h3><p class="text-sm text-white/55 leading-relaxed mt-auto pt-6">{d}</p></article>)}</div></div></section>
<section class="hightech-section bg-signal-400 text-graphite-950"><div class="hightech-container grid lg:grid-cols-[.72fr_1.28fr] gap-10 lg:gap-16 items-center"><div><div class="text-[10px] uppercase tracking-[.2em] opacity-60 mb-4">Valós saját projekt · FuratMester</div><h2 class="font-serif text-4xl sm:text-5xl font-light leading-[.95]">A kereséstől a leadig <span class="opacity-60">ugyanezt a logikát használjuk.</span></h2></div><div class="bg-graphite-950 text-white p-7 md:p-9"><div class="grid sm:grid-cols-3 gap-px bg-white/10 mb-7"><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">LIVE</div><div class="text-xs text-white/50 mt-1">éles szolgáltatás</div></div><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">GA4 + GTM</div><div class="text-xs text-white/50 mt-1">leadmérés</div></div><div class="bg-graphite-950 p-4"><div class="text-signal-400 text-xl">ADS → LEAD</div><div class="text-xs text-white/50 mt-1">összekötött funnel</div></div></div><p class="text-white/60 leading-relaxed">A FuratMesternél a keresési szándék, a szolgáltatás-specifikus landing, az ajánlat, a Google Ads és a leadmérés egyetlen ügyfélútként működik. Nem bemutató projekt: saját éles üzleti rendszer.</p><a href="/esettanulmanyok/furatmester-digitalis-ugyfelszerzes/" data-track-cta="FuratMester proof" data-track-location="acquisition_proof" class="inline-flex items-center gap-2 mt-6 text-signal-400">Megnézem az esettanulmányt <ArrowRight className="w-4 h-4"/></a></div></div></section>
<section class="hightech-section bg-graphite-950"><div class="hightech-container grid lg:grid-cols-2 gap-12"><div><BarChart3 className="w-6 h-6 text-signal-400 mb-5"/><div class="text-[10px] uppercase tracking-[.2em] text-signal-400 mb-3">LS/03 · GROW</div><h2 class="font-serif text-4xl sm:text-5xl font-light">Komplett ügyfélszerző rendszer <span class="text-signal-400">jellemzően 450–650 000 Ft.</span></h2><p class="mt-6 text-white/55 leading-relaxed">Ez a fő ajánlatunk működő szolgáltató vállalkozásoknak. Nem hirdetési költést adunk el: a teljes utat tesszük mérhetővé a kereséstől a leadig. A pontos projektár a szükséges landingek, mérés és integrációk alapján áll össze; a médiaköltés és külső szolgáltatói díjak külön költségek.</p></div><div class="tech-card-dark p-7">{['Komplett web- és landing rendszer','Kulcsszó- és konkurenciakutatás','SEO + keresési szándék','GA4 + GTM + lead események','Google Ads-ready konverziómérés','CTA + funnel optimalizálás','Alap automatizálások','60 nap finomhangolás'].map(x=><div class="flex gap-3 border-b border-white/10 py-3 text-white/70"><Check className="w-4 h-4 text-signal-400 shrink-0 mt-0.5"/><span>{x}</span></div>)}<a href="/kapcsolat/#diagnosztika" data-track-cta="Acquisition landing diagnózis" data-track-location="acquisition_package" class="signal-button-primary mt-7 inline-flex">Nézzük meg, hol folyik el a lead <ArrowRight className="w-4 h-4"/></a></div></div></section><div id="kapcsolat"><Contact client:visible/></div></main><Footer/></BaseLayout>