---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
---

<BaseLayout
  title="404 – Oldal nem található | Levente Studio"
  description="A keresett oldal nem található. Térj vissza a Levente Studio főoldalára, megoldásaihoz vagy tudástárához."
  noindex={true}
>
  <div class="min-h-screen bg-graphite-950 text-white flex flex-col">
    <HeaderAstro />

    <main class="flex-grow flex items-center justify-center px-5 sm:px-6 pt-32 pb-16 relative overflow-hidden">
      <div class="absolute inset-0 subpage-signal-grid opacity-45 pointer-events-none"></div>
      <div class="absolute inset-0 subpage-glow pointer-events-none"></div>

      <div class="max-w-5xl w-full relative z-10 grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-end">
        <div>
          <div class="signal-kicker mb-6"><span class="signal-dot"></span>Oldal nem található</div>
          <div class="font-serif text-[8rem] sm:text-[11rem] md:text-[14rem] leading-[0.7] tracking-editorial text-signal-400">404</div>
        </div>

        <div>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl font-light tracking-editorial leading-[0.92] mb-6 text-balance">
            Ez az útvonal már <span class="text-signal-400">nem aktív.</span>
          </h1>
          <p class="text-base sm:text-lg text-white/55 font-light leading-relaxed mb-8 max-w-2xl">
            Lehet, hogy az oldal címe megváltozott vagy már nem érhető el. Innen gyorsan visszatalálsz a fontos részekhez.
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap gap-3">
            <a href="/" class="signal-button-primary">Főoldal ↗</a>
            <a href="/megoldasok/" class="signal-button-secondary">Megoldások</a>
            <a href="/blog/" class="signal-button-secondary">Tudástár</a>
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
