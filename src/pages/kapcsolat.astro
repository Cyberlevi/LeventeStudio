---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import LeadDiagnostic from '../components/LeadDiagnostic.astro';
import Contact2026 from '../components/Contact2026';
import Footer from '../components/Footer';
import MobileStickyBar2026 from '../components/MobileStickyBar2026';
---
<BaseLayout title="Ajánlatkérés és kapcsolat | Levente Studio" description="Írd meg, milyen weboldalra vagy fejlesztésre van szükséged. Személyesen egyeztetünk a feladatról és az ajánlatról." canonical="/kapcsolat/">
  <HeaderAstro /><MobileStickyBar2026 ctaHref="#diagnosztika" />
  <main class="bg-graphite-950 pt-28"><div class="mx-auto max-w-6xl px-5 pb-8 sm:px-6"><p class="text-sm text-ivory-400">Ajánlatkérés és kapcsolat</p></div><LeadDiagnostic headingLevel="h1" /><Contact2026 /></main>
  <Footer />
</BaseLayout>
