---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
import CookieBanner from '../components/CookieBanner';
import MobileStickyBar from '../components/MobileStickyBar';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Kapcsolat - Levente Studio',
  'description': 'Rendszertervezési egyeztetés weboldal, SEO, mérés, leadkezelés és automatizálás témában.',
  'url': 'https://leventestudio.app/kapcsolat/',
  'provider': {
    '@type': 'Person',
    'name': 'Tarnóczi Levente',
    'jobTitle': 'Digitális rendszerépítő',
    'telephone': '+36202826843',
    'email': 'hello@leventestudio.app',
    'url': 'https://leventestudio.app/rolam/'
  }
};
---

<BaseLayout
  title="Kapcsolat – Rendszertervezés | Levente Studio"
  description="Beszéljük át a digitális ügyfélszerzésedet: weboldal, SEO, mérés, leadkezelés és automatizálás. WhatsApp, email vagy telefon."
  canonical="/kapcsolat/"
  structuredData={structuredData}
>
  <CookieBanner client:load />
  <MobileStickyBar client:load />

  <div class="min-h-screen bg-white pt-16">
    <HeaderAstro />
    <Contact client:load />
    <Footer />
  </div>
</BaseLayout>
