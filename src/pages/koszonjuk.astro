---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from '../components/HeaderAstro.astro';
import Footer from '../components/Footer';
---
<BaseLayout title="Köszönöm a megkeresést | Levente Studio" description="Az ajánlatkérés utáni következő lépések." canonical="/koszonjuk/" noindex={true}>
  <HeaderAstro />
  <main class="min-h-screen bg-graphite-950 px-5 pb-24 pt-36 text-ivory-100 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs uppercase tracking-[.2em] text-signal-400">Levente Studio · ajánlatkérés</p>
      <h1 id="receipt-title" class="mt-6 font-serif text-5xl font-light leading-[1.02] tracking-editorial sm:text-7xl">Köszönöm az érdeklődést.</h1>
      <p id="receipt-message" class="mt-6 text-lg leading-relaxed text-ivory-300">Ha elküldted az űrlapot, személyesen átnézem a megkeresésedet, és e-mailben egyeztetünk a részletekről. Új megkeresést az ajánlatkérő oldalon tudsz küldeni.</p>
      <section id="route-result" hidden class="mt-10 rounded-xl border border-white/15 bg-white/[.03] p-6 sm:p-8">
        <p class="text-xs uppercase tracking-[.18em] text-signal-400">Javasolt kiindulópont · <span id="route-code"></span></p>
        <h2 id="route-name" class="mt-3 text-2xl font-medium"></h2><p id="route-price" class="mt-3 text-xl text-signal-300"></p>
        <p id="route-reason" class="mt-5 text-sm leading-relaxed text-ivory-300"></p>
        <a id="route-link" href="/#csomagok" class="mt-6 inline-block text-sm underline underline-offset-4">Csomag részletei ↗</a>
      </section>
      <p id="receipt-reference" hidden class="mt-6 text-sm text-ivory-300"></p>
      <ol class="mt-10 grid gap-5 sm:grid-cols-3">{[['01','Átnézem a megkeresést'],['02','Egyeztetjük a részleteket'],['03','Írásos ajánlatot készítek']].map(([number,text]) => <li class="border-t border-white/15 pt-4"><span class="text-xs text-signal-400">{number}</span><p class="mt-3 text-sm">{text}</p></li>)}</ol>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row"><a href="/esettanulmanyok/" class="signal-button-primary">Munkáink megtekintése</a><a href="/" class="signal-button-secondary">Vissza a főoldalra</a></div>
    </div>
  </main><Footer />
  <script>
    import { getDiagnosticRoute } from '../scripts/diagnostic-routing';
    import { findReference } from '../data/studio-offers';
    import { pushToDataLayer } from '../utils/gtm';
    let raw = '';
    try { raw = sessionStorage.getItem('ls_inquiry_receipt_v2') || ''; sessionStorage.removeItem('ls_inquiry_receipt_v2'); } catch { /* No storage: keep generic confirmation copy. */ }
    if (raw) {
      try {
        const receipt = JSON.parse(raw);
        if (typeof receipt.createdAt === 'number' && Date.now() - receipt.createdAt >= 0 && Date.now() - receipt.createdAt < 30 * 60 * 1000) {
          const title = document.getElementById('receipt-title');
          const message = document.getElementById('receipt-message');
          if (title) title.textContent = 'Megérkezett az ajánlatkérésed.';
          if (message) message.textContent = 'Köszönöm! Személyesen átnézem, amit írtál, és a megadott e-mail-címen egyeztetünk a következő lépésről.';
          const route = getDiagnosticRoute(typeof receipt.goal === 'string' ? receipt.goal : '', typeof receipt.selected === 'string' ? receipt.selected : '');
          if (route) {
            const box = document.getElementById('route-result');
            if (box) box.hidden = false;
            for (const [id,value] of Object.entries({ 'route-code': route.id, 'route-name': route.name, 'route-price': route.price, 'route-reason': route.reason })) { const node=document.getElementById(id); if(node) node.textContent=value; }
            const link = document.getElementById('route-link');
            if (link instanceof HTMLAnchorElement) link.href=route.href;
          }
          const reference = findReference(receipt.project);
          const referenceNode = document.getElementById('receipt-reference');
          if (reference && referenceNode) { referenceNode.textContent = `A megjelölt referencia: ${reference.name}.`; referenceNode.hidden=false; }
          pushToDataLayer({ event: 'generate_lead', lead_type: 'system_diagnostic', lead_source: 'netlify_form', recommended_system: route?.code || 'MANUAL', selected_package: route?.id || '', reference_project: reference?.id || '', source_page: receipt.source || 'unknown', entry_page: receipt.entry || 'unknown' });
        }
      } catch { /* Invalid receipt: no conversion event and no automatic recommendation. */ }
    }
  </script>
</BaseLayout>
