---
import BaseLayout from '../layouts/BaseLayout.astro'; import HeaderAstro from '../components/HeaderAstro.astro'; import Footer from '../components/Footer'; import CookieBanner from '../components/CookieBanner';
---
<BaseLayout title="Köszönöm a megkeresést | Levente Studio" description="A rendszerdiagnózis megérkezett. Innen már konkrétan tudunk továbbmenni." canonical="/koszonjuk/" noindex={true}><CookieBanner client:load/><div class="min-h-screen bg-graphite-950 text-white flex flex-col"><HeaderAstro/><main class="relative flex-1 overflow-hidden px-5 pb-24 pt-40 sm:px-6"><div class="absolute inset-0 subpage-signal-grid opacity-35 pointer-events-none"></div><div class="absolute inset-0 subpage-glow pointer-events-none"></div><div class="relative mx-auto max-w-5xl"><div class="text-center"><div class="signal-kicker mb-6 justify-center"><span class="signal-dot"></span>Rendszerdiagnózis elküldve</div><h1 class="font-serif text-5xl font-light leading-[0.92] tracking-editorial text-balance sm:text-6xl md:text-8xl">Megérkezett.<span class="block text-signal-400">Most már van miből kiindulni.</span></h1><p class="mx-auto mt-7 max-w-2xl text-base font-light leading-relaxed text-white/55 sm:text-lg">A beküldött cél alapján már mutatunk egy előzetes rendszerirányt. Ez nem automatikus ajánlat: a végleges javaslat előtt emberileg is átnézem a helyzetet.</p></div><section id="route-result" class="mx-auto mt-12 max-w-3xl border border-signal-400/25 bg-white/[.025] p-6 sm:p-8" hidden><div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"><div><div class="text-[10px] uppercase tracking-[.18em] text-signal-400">Előzetes irány · <span id="route-code"></span></div><h2 id="route-name" class="mt-3 font-serif text-3xl font-light sm:text-4xl"></h2><div id="route-price" class="mt-2 text-lg text-signal-400"></div></div><div class="text-[10px] uppercase tracking-[.16em] text-white/30">Nem végleges ajánlat</div></div><p id="route-reason" class="mt-6 max-w-2xl text-white/55 leading-relaxed"></p><a id="route-link" href="/megoldasok/" data-track-cta="Diagnostic recommended system" data-track-location="thank_you_route" class="signal-button-secondary mt-7 inline-flex">Megnézem ezt a rendszert ↗</a></section><section id="route-unknown" class="mx-auto mt-12 max-w-3xl border border-white/10 bg-white/[.025] p-6 text-center sm:p-8" hidden><div class="text-[10px] uppercase tracking-[.18em] text-signal-400">Emberi átnézés szükséges</div><h2 class="mt-3 font-serif text-3xl font-light">Itt nem lenne korrekt automatikusan csomagot mondani.</h2><p class="mt-4 text-white/55">Átnézem a megadott helyzetet, és abból indulunk ki, hol van a valódi szűk keresztmetszet.</p></section><div class="mx-auto mt-6 grid max-w-3xl gap-4 text-left sm:grid-cols-3"><div class="tech-card-dark p-5"><div class="mb-2 text-[10px] uppercase tracking-[0.18em] text-signal-400">01</div><div class="text-white">Beküldés megérkezett</div></div><div class="tech-card-dark p-5"><div class="mb-2 text-[10px] uppercase tracking-[0.18em] text-signal-400">02</div><div class="text-white">Emberi átnézés</div></div><div class="tech-card-dark p-5"><div class="mb-2 text-[10px] uppercase tracking-[0.18em] text-signal-400">03</div><div class="text-white">Konkrét rendszerirány</div></div></div><div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row"><a href="/" class="signal-button-primary">Vissza a főoldalra ↗</a><a href="https://wa.me/36202826843?text=Szia%2C%20elk%C3%BCldtem%20a%20Levente%20Studio%20rendszerdiagn%C3%B3zist." target="_blank" rel="noopener noreferrer" data-track-event="whatsapp_after_lead" data-track-location="thank_you" class="signal-button-secondary">WhatsAppon is jelzek</a></div></div></main><Footer/></div><script is:inline>(()=>{const pendingKey='ls_lead_submission_pending_v1';let confirmed=false,source='',entry='',goal='',bottleneck='';try{confirmed=sessionStorage.getItem(pendingKey)==='1';source=sessionStorage.getItem('ls_lead_source_v1')||'';entry=sessionStorage.getItem('ls_entry_page_v1')||'';goal=sessionStorage.getItem('ls_diagnostic_goal_v1')||'';bottleneck=sessionStorage.getItem('ls_diagnostic_bottleneck_v1')||'';if(confirmed){sessionStorage.removeItem(pendingKey);sessionStorage.removeItem('ls_lead_source_v1');}}catch(_){}if(!confirmed)return;const push=(name,extra={})=>{const data={event:name,source_page:source||'unknown',entry_page:entry||'unknown',...extra};window.dataLayer=window.dataLayer||[];window.dataLayer.push(data);if(typeof window.gtag==='function')window.gtag('event',name,{source_page:source||'unknown',entry_page:entry||'unknown',...extra});};push('generate_lead',{lead_type:'system_diagnostic',lead_source:'netlify_form'});let route=null;if(goal==='rebuild')route={code:'SYS/01',name:'Ügyfélszerző weboldal',price:'250 000 Ft-tól',href:'/weboldal-keszites/',reason:'A megadott cél alapján először az online alapot és az ajánlatkérési utat érdemes rendbe tenni.'};else if(['more-leads','better-leads','measurement'].includes(goal))route={code:'SYS/02',name:'Komplett ügyfélszerző rendszer',price:'500 000 Ft-tól',href:'/ugyfelszerzes/',reason:'A megadott cél alapján a kereslet, a landing és a mérés összekötése a logikus első irány.'};else if(goal==='automation')route={code:'SYS/03',name:'Automatizált ügyfélkezelés',price:'750 000 Ft-tól',href:'/ai-automatizalas/',reason:'A megadott cél alapján a leadkezelés és az ismétlődő folyamatok rendszerbe szervezése lehet a következő szint.'};if(route){const box=document.getElementById('route-result'),code=document.getElementById('route-code'),name=document.getElementById('route-name'),price=document.getElementById('route-price'),reason=document.getElementById('route-reason'),link=document.getElementById('route-link');if(box)box.hidden=false;if(code)code.textContent=route.code;if(name)name.textContent=route.name;if(price)price.textContent=route.price;if(reason)reason.textContent=route.reason;if(link instanceof HTMLAnchorElement)link.href=route.href;push('diagnostic_route_view',{recommended_system:route.code,primary_goal:goal,bottleneck});}else{const unknown=document.getElementById('route-unknown');if(unknown)unknown.hidden=false;push('diagnostic_route_view',{recommended_system:'manual-review',primary_goal:goal||'unknown',bottleneck});}})();</script></BaseLayout>