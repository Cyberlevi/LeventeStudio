---
import '../index.css';
import '../styles/document-mode.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object;
}

const {
  title = 'Levente Studio – AI-native ügyfélszerző rendszerek',
  description = 'Weboldal, SEO, mérés, leadkezelés és automatizálás egy rendszerben szolgáltató vállalkozásoknak.',
  canonical = Astro.url.pathname,
  ogImage = '/og-levente-studio-2026.png',
  ogImageAlt = 'Levente Studio – Nem csak weboldalt. Ügyfélszerző rendszert.',
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = 'https://leventestudio.app';
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ogImageType = fullOgImage.endsWith('.png')
  ? 'image/png'
  : fullOgImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const hasCustomHead = Astro.slots.has('head');
const documentPaths = ['/adatvedelem/', '/suti-szabalyzat/', '/jogi-informaciok/'];
const isDocumentMode = documentPaths.includes(Astro.url.pathname);
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#bfe85a" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Levente Studio" />
    <meta name="apple-mobile-web-app-title" content="Levente Studio" />
    <meta name="theme-color" content="#0b0d0c" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/diagnostic-console.css" />

    <link rel="canonical" href={fullCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {hasCustomHead ? (
      <slot name="head" />
    ) : (
      <>
        <title>{title}</title>
        <meta name="description" content={description} />

        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={fullCanonical} />
        <meta property="og:site_name" content="Levente Studio" />
        <meta property="og:locale" content="hu_HU" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={fullOgImage} />
        <meta property="og:image:secure_url" content={fullOgImage} />
        <meta property="og:image:type" content={ogImageType} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={fullOgImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
      </>
    )}

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      gtag('js', new Date());
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LNDL3K56Q2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('config', 'G-LNDL3K56Q2');
    </script>
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-WZHLTWBD');
    </script>
    <script>import '../scripts/scroll-tracking';</script>
  </head>
  <body class:list={{ 'document-mode': isDocumentMode }}>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WZHLTWBD" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    <script is:inline>
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-cookie-settings]') : null;
        if (!target) return;
        try { localStorage.removeItem('ls_consent_v1'); } catch (_) {}
        try { sessionStorage.removeItem('ls_consent_v1'); } catch (_) {}
        window.location.reload();
      });
    </script>
  </body>
</html>
