---
import '../index.css';
import '../styles/document-mode.css';
import CookieBanner from '../components/CookieBanner.astro';
export interface Props {title?:string;description?:string;canonical?:string;ogImage?:string;ogImageAlt?:string;ogType?:string;noindex?:boolean;structuredData?:object;}
const routeOgSources:Record<string,string>={'/esettanulmanyok/':'/og-munkak-2026.svg','/esettanulmanyok/klima18ker-weboldal-audit/':'/og-klima18ker-2026.svg','/esettanulmanyok/furatmester-digitalis-ugyfelszerzes/':'/og-furatmester-2026.svg','/esettanulmanyok/bundavarazs-helyi-ugyfelszerzes/':'/og-bundavarazs-2026.svg','/blog/':'/og-tudastar-2026.svg','/blog/google-search-console-hibak/':'/og-google-search-console-hibak-2026.svg','/blog/miert-lassu-a-wordpress-oldalam/':'/og-miert-lassu-wordpress-2026.svg','/blog/mikor-erdemes-weboldal-auditot-kerni/':'/og-weboldal-audit-mikor-2026.svg','/blog/ux-audit-specifikacio/':'/og-ux-audit-specifikacio-2026.svg','/blog/weboldal-konverzio-optimalizalas/':'/og-konverzio-optimalizalas-2026.svg'};
const routeOgSource=routeOgSources[Astro.url.pathname];const routeOgImage=routeOgSource?`/.netlify/images?url=${encodeURIComponent(routeOgSource)}&w=1200&h=630&fit=cover&fm=jpg&q=90`:'/og-levente-studio-2026.png';const routeOgType=((Astro.url.pathname.startsWith('/blog/')&&Astro.url.pathname!='/blog/')||(Astro.url.pathname.startsWith('/esettanulmanyok/')&&Astro.url.pathname!='/esettanulmanyok/'))?'article':'website';
const {title='Levente Studio – weboldalak szolgáltató vállalkozásoknak',description='Profi weboldalak szolgáltató vállalkozásoknak: tervezés, fejlesztés, mérés és gondozás közvetlen együttműködésben.',canonical=Astro.url.pathname,ogImage=routeOgImage,ogImageAlt='Levente Studio – weboldalak szolgáltató vállalkozásoknak.',ogType=routeOgType,noindex=false,structuredData}=Astro.props;const siteUrl='https://leventestudio.app';const fullCanonical=canonical.startsWith('http')?canonical:`${siteUrl}${canonical}`;const fullOgImage=ogImage.startsWith('http')?ogImage:`${siteUrl}${ogImage}`;const ogImageType=fullOgImage.endsWith('.png')?'image/png':fullOgImage.endsWith('.webp')?'image/webp':'image/jpeg';const hasCustomHead=Astro.slots.has('head');const documentPaths=['/adatvedelem/','/suti-szabalyzat/','/jogi-informaciok/'];const isDocumentMode=documentPaths.includes(Astro.url.pathname);
---
<!doctype html><html lang="hu"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="mask-icon" href="/safari-pinned-tab.svg" color="#bfe85a"/><link rel="manifest" href="/site.webmanifest"/><meta name="application-name" content="Levente Studio"/><meta name="apple-mobile-web-app-title" content="Levente Studio"/><meta name="theme-color" content="#0b0d0c"/><meta name="color-scheme" content="light dark"/><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"><link rel="canonical" href={fullCanonical}/>{noindex&&<meta name="robots" content="noindex, nofollow"/>}{hasCustomHead?<slot name="head"/>:<><title>{title}</title><meta name="description" content={description}/><meta property="og:type" content={ogType}/><meta property="og:url" content={fullCanonical}/><meta property="og:site_name" content="Levente Studio"/><meta property="og:locale" content="hu_HU"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={fullOgImage}/><meta property="og:image:secure_url" content={fullOgImage}/><meta property="og:image:type" content={ogImageType}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={ogImageAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={fullOgImage}/><meta name="twitter:image:alt" content={ogImageAlt}/></>}{structuredData&&<script type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{'analytics_storage':'denied','ad_storage':'denied','ad_user_data':'denied','ad_personalization':'denied','wait_for_update':500});</script><script>import '../scripts/scroll-tracking';import '../scripts/demand-attribution';</script></head><body class:list={{'document-mode':isDocumentMode}}><a href="#main-content" class="fixed left-4 top-4 z-[120] -translate-y-24 bg-signal-400 px-4 py-3 font-medium text-graphite-950 transition-transform focus:translate-y-0">Ugrás a tartalomra</a><CookieBanner /><slot/><script is:inline>
const mainContent=document.querySelector('main');if(mainContent&&!mainContent.id)mainContent.id='main-content';
document.addEventListener('click',(event)=>{const element=event.target instanceof Element?event.target:null;if(!element)return;const contactLink=element.closest('a[href^="/kapcsolat"]');if(contactLink instanceof HTMLAnchorElement){try{sessionStorage.setItem('ls_quote_source_page_v1',window.location.pathname);}catch(_){}}const cookieTarget=element.closest('[data-cookie-settings]');if(cookieTarget){try{localStorage.removeItem('ls_consent_v1');}catch(_){}try{sessionStorage.removeItem('ls_consent_v1');}catch(_){}window.location.reload();return;}const faqTarget=element.closest('[data-track-faq]');if(faqTarget instanceof HTMLElement){const details=faqTarget.closest('details');if(details instanceof HTMLDetailsElement&&!details.open){const index=faqTarget.dataset.faqIndex,question=faqTarget.dataset.faqQuestion,eventData={event:'faq_expand',interaction_type:'faq_expand',interaction_target:`faq_${index||'unknown'}`,interaction_value:question||''};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event','faq_expand',{interaction_type:'faq_expand',interaction_target:`faq_${index||'unknown'}`,interaction_value:question||''});}return;}const channelTarget=element.closest('[data-track-event]');if(channelTarget instanceof HTMLElement){const eventName=channelTarget.dataset.trackEvent,location=channelTarget.dataset.trackLocation;if(eventName&&location){const eventData={event:eventName,click_location:location,source_page:window.location.pathname};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event',eventName,{click_location:location,source_page:window.location.pathname});}return;}const ctaTarget=element.closest('[data-track-cta]');if(!(ctaTarget instanceof HTMLElement))return;const buttonText=ctaTarget.dataset.trackCta,location=ctaTarget.dataset.trackLocation;if(!buttonText||!location)return;const eventData={event:'cta_click',button_text:buttonText,page_location:location,source_page:window.location.pathname};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event','cta_click',{button_text:buttonText,page_location:location,source_page:window.location.pathname});});
</script></body></html>
