import '../index.css';
import '../styles/document-mode.css';
import CookieBanner from '../components/CookieBanner.astro';
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: object;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}
const routeOgImage='/og-levente-studio-2026.png';
const routeOgType=((Astro.url.pathname.startsWith('/blog/')&&Astro.url.pathname!='/blog/')||(Astro.url.pathname.startsWith('/esettanulmanyok/')&&Astro.url.pathname!='/esettanulmanyok/'))?'article':'website';
const {
  title='Levente Studio – weboldalak szolgáltató vállalkozásoknak',
  description='Profi weboldalak szolgáltató vállalkozásoknak: tervezés, fejlesztés, mérés és gondozás közvetlen együttműködésben.',
  canonical=Astro.url.pathname,
  ogImage=routeOgImage,
  ogImageAlt='Levente Studio – weboldalak szolgáltató vállalkozásoknak.',
  ogType=routeOgType,
  noindex=false,
  structuredData,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor='https://leventestudio.app/rolam/'
}=Astro.props;const siteUrl='https://leventestudio.app';
const fullCanonical=canonical.startsWith('http')?canonical:`${siteUrl}${canonical}`;
const fullOgImage=ogImage.startsWith('http')?ogImage:`${siteUrl}${ogImage}`;
const ogImageType=fullOgImage.endsWith('.png')?'image/png':fullOgImage.endsWith('.webp')?'image/webp':'image/jpeg';
const hasCustomHead=Astro.slots.has('head');
const documentPaths=['/adatvedelem/','/suti-szabalyzat/','/jogi-informaciok/'];
const isDocumentMode=documentPaths.includes(Astro.url.pathname);
const siteIdentityData={
  '@context':'https://schema.org',
  '@type':'WebSite',
  '@id':'https://leventestudio.app/#website',
  name:'Levente Studio',
  alternateName:'LeventeStudio',
  url:'https://leventestudio.app/',
  inLanguage:'hu-HU',
  publisher:{
    '@type':'Organization',
    '@id':'https://leventestudio.app/#organization',
    name:'Levente Studio',
    url:'https://leventestudio.app/',
    logo:{
      '@type':'ImageObject',
      url:'https://leventestudio.app/android-chrome-512x512.png',
      width:512,
      height:512
    }
  }
};
