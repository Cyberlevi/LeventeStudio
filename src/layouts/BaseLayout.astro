<!doctype html><html lang="hu"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png"/><link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/><link rel="mask-icon" href="/safari-pinned-tab.svg" color="#bfe85a"/><link rel="manifest" href="/site.webmanifest"/><meta name="application-name" content="Levente Studio"/><meta name="apple-mobile-web-app-title" content="Levente Studio"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/><meta name="theme-color" content="#0b0d0c"/><meta name="color-scheme" content="light dark"/><script is:inline>
try{
  const isHome=location.pathname==='/'||location.pathname==='/index.html';
  const reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(isHome&&!reduce)document.documentElement.classList.add('ls-intro-pending');
}catch(_){}
</script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"><link rel="canonical" href={fullCanonical}/>{noindex?<meta name="robots" content="noindex, nofollow"/>:<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"/>}{hasCustomHead?<slot name="head"/>:<><title>{title}</title><meta name="description" content={description}/><meta name="author" content="Tarnóczi Levente"/><meta property="og:type" content={ogType}/><meta property="og:url" content={fullCanonical}/><meta property="og:site_name" content="Levente Studio"/><meta property="og:locale" content="hu_HU"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={fullOgImage}/><meta property="og:image:secure_url" content={fullOgImage}/><meta property="og:image:type" content={ogImageType}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={ogImageAlt}/>{ogType==='article'&&articlePublishedTime&&<meta property="article:published_time" content={articlePublishedTime}/>} {ogType==='article'&&articleModifiedTime&&<meta property="article:modified_time" content={articleModifiedTime}/>} {ogType==='article'&&articleAuthor&&<meta property="article:author" content={articleAuthor}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={fullOgImage}/><meta name="twitter:image:alt" content={ogImageAlt}/></>}<script type="application/ld+json" set:html={JSON.stringify(siteIdentityData)}/>{structuredData&&<script type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{'analytics_storage':'denied','ad_storage':'denied','ad_user_data':'denied','ad_personalization':'denied','wait_for_update':500});</script><script>import '../scripts/scroll-tracking';import '../scripts/demand-attribution';import '../scripts/mobile-sticky-visibility';</script></head><body class:list={{'document-mode':isDocumentMode}}><a href="#main-content" class="fixed left-4 top-4 z-[120] -translate-y-24 bg-signal-400 px-4 py-3 font-medium text-graphite-950 transition-transform focus:translate-y-0">Ugrás a tartalomra</a><CookieBanner /><slot/><script is:inline>
const mainContent=document.querySelector('main');if(mainContent&&!mainContent.id)mainContent.id='main-content';
const canTrack=()=>{try{const raw=localStorage.getItem('ls_consent_v1')||sessionStorage.getItem('ls_consent_v1');if(!raw)return false;const state=JSON.parse(raw);return Boolean(state?.analytics||state?.marketing);}catch(_){return false;}};
document.addEventListener('click',(event)=>{const element=event.target instanceof Element?event.target:null;if(!element)return;const contactLink=element.closest('a[href^="/kapcsolat"]');if(contactLink instanceof HTMLAnchorElement){try{sessionStorage.setItem('ls_quote_source_page_v1',window.location.pathname);}catch(_){}}const cookieTarget=element.closest('[data-cookie-settings]');if(cookieTarget){try{localStorage.removeItem('ls_consent_v1');}catch(_){}try{sessionStorage.removeItem('ls_consent_v1');}catch(_){}window.location.reload();return;}const faqTarget=element.closest('[data-track-faq]');if(faqTarget instanceof HTMLElement){if(!canTrack())return;const details=faqTarget.closest('details');if(details instanceof HTMLDetailsElement&&!details.open){const index=faqTarget.dataset.faqIndex,question=faqTarget.dataset.faqQuestion,eventData={event:'faq_expand',interaction_type:'faq_expand',interaction_target:`faq_${index||'unknown'}`,interaction_value:question||''};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event','faq_expand',{interaction_type:'faq_expand',interaction_target:`faq_${index||'unknown'}`,interaction_value:question||''});}return;}const channelTarget=element.closest('[data-track-event]');if(channelTarget instanceof HTMLElement){if(!canTrack())return;const eventName=channelTarget.dataset.trackEvent,location=channelTarget.dataset.trackLocation;if(eventName&&location){const eventData={event:eventName,click_location:location,source_page:window.location.pathname};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event',eventName,{click_location:location,source_page:window.location.pathname});}return;}const ctaTarget=element.closest('[data-track-cta]');if(!(ctaTarget instanceof HTMLElement)||!canTrack())return;const buttonText=ctaTarget.dataset.trackCta,location=ctaTarget.dataset.trackLocation;if(!buttonText||!location)return;const eventData={event:'cta_click',button_text:buttonText,page_location:location,source_page:window.location.pathname};window.dataLayer=window.dataLayer||[];window.dataLayer.push(eventData);if(typeof window.gtag==='function')window.gtag('event','cta_click',{button_text:buttonText,page_location:location,source_page:window.location.pathname});});
</script></body></html>
