---
import '../styles/article-prose.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderAstro from './HeaderAstro.astro';
import Footer from './Footer';
import MobileStickyBar from './MobileStickyBar';
import AuthorBox from './AuthorBox';
import RelatedContent from './RelatedContent';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  readingTime?: string;
  relatedContent?: Array<{ title: string; description: string; url: string; type: 'blog' | 'service' | 'case-study'; }>;
}

const { title, description, publishDate, readingTime = '10 perc olvasás', relatedContent = [] } = Astro.props;
const formattedDate = new Date(publishDate).toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'datePublished': publishDate,
  'dateModified': publishDate,
  'inLanguage': 'hu-HU',
  'image': 'https://leventestudio.app/og-levente-studio-2026.png',
  'author': { '@type': 'Person', '@id': 'https://leventestudio.app/rolam/#tarnoczi-levente', 'name': 'Tarnóczi Levente', 'url': 'https://leventestudio.app/rolam/', 'image': 'https://leventestudio.app/levente_studio_portrait_final.webp' },
  'publisher': { '@type': 'Organization', '@id': 'https://leventestudio.app/#organization', 'name': 'Levente Studio', 'url': 'https://leventestudio.app/' },
  'mainEntityOfPage': { '@type': 'WebPage', '@id': Astro.url.href }
};
---

<BaseLayout title={title} description={description} canonical={Astro.url.pathname} ogType="article" structuredData={structuredData}>
  <MobileStickyBar />
  <HeaderAstro />

  <main class="bg-graphite-950">
    <header class="relative overflow-hidden bg-graphite-950 text-white pt-36 sm:pt-40 lg:pt-44 pb-14 sm:pb-16 lg:pb-20">
      <div class="absolute inset-0 studio-grid-dark opacity-35 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_82%_20%,rgba(216,255,120,.10),transparent_24%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl px-5 sm:px-6 lg:px-8">
        <nav class="mb-7 flex flex-wrap items-center gap-2 text-xs sm:text-sm text-white/60" aria-label="Morzsanavigáció">
          <a href="/" class="hover:text-white transition-colors">Főoldal</a>
          <span class="text-white/40" aria-hidden="true">/</span>
          <a href="/blog/" class="hover:text-white transition-colors">Tudástár</a>
        </nav>

        <div class="mb-5 inline-flex items-center gap-3 text-[11px] sm:text-xs uppercase tracking-[0.2em] text-white/70">
          <span class="signal-dot" aria-hidden="true"></span>
          Gyakorlati útmutató
        </div>

        <h1 class="max-w-[18ch] font-serif text-[clamp(2.75rem,6.2vw,5.4rem)] font-light leading-[0.96] tracking-editorial text-balance">
          {title}
        </h1>
        <p class="mt-6 max-w-3xl text-base sm:text-lg lg:text-xl font-light leading-relaxed text-white/70">
          {description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-5 text-sm text-white/60">
          <time datetime={publishDate}>{formattedDate}</time>
          <span class="hidden sm:inline text-white/40" aria-hidden="true">•</span>
          <span>{readingTime}</span>
          <span class="hidden sm:inline text-white/40" aria-hidden="true">•</span>
          <a href="/rolam/" class="hover:text-white transition-colors">Tarnóczi Levente</a>
        </div>
      </div>
    </header>

    <article class="bg-graphite-900 text-ivory-100">
      <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_240px] gap-12 lg:gap-16 items-start">
          <div class="min-w-0 max-w-[46rem]">
            <div id="article-content" class="article-prose"><slot /></div>
            <AuthorBox />
            {relatedContent.length > 0 && <RelatedContent items={relatedContent} />}
          </div>

          <aside class="hidden lg:block sticky top-28" aria-label="Cikk tartalomjegyzéke">
            <div class="border-l border-white/10 pl-5">
              <div class="mb-4 text-[10px] uppercase tracking-[0.18em] text-white/55">Tartalom</div>
              <nav id="article-toc" class="space-y-3 text-sm leading-snug text-white/60">
                <span class="text-white/45">Fejezetek betöltése…</span>
              </nav>
              <div class="mt-7 border-t border-white/10 pt-5 text-xs leading-relaxed text-white/50">
                <div class="font-medium text-white/75">{readingTime}</div>
                <div class="mt-1">Frissítve: {formattedDate}</div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>

    <section class="hightech-section bg-graphite-950 text-white relative overflow-hidden">
      <div class="absolute inset-0 subpage-signal-grid opacity-25 pointer-events-none" aria-hidden="true"></div>
      <div class="hightech-container relative">
        <div class="max-w-3xl">
          <div class="signal-kicker mb-4"><span class="signal-dot"></span>Következő lépés</div>
          <h2 class="font-serif text-4xl sm:text-5xl md:text-6xl font-light tracking-editorial leading-[0.95] text-balance">A saját rendszeredben is van egy szűk keresztmetszet?</h2>
          <p class="text-white/70 mt-5 mb-7 font-light leading-relaxed text-base sm:text-lg max-w-2xl">Nem kell találgatni. Írd meg röviden, hol akadt el a weboldalad vagy az ügyfélszerzésed, és megnézzük, honnan érdemes elindulni.</p>
          <a href="/kapcsolat/#diagnosztika" data-track-cta="Ajánlatot kérek" data-track-location="blog_bottom" class="signal-button-primary">Ajánlatot kérek <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (() => {
      const content = document.getElementById('article-content');
      const toc = document.getElementById('article-toc');
      if (!content || !toc) return;

      const headings = Array.from(content.querySelectorAll('h2'));
      if (!headings.length) {
        toc.innerHTML = '<span class="text-white/45">Rövid útmutató</span>';
        return;
      }

      const slugify = (value) => value
        .toLocaleLowerCase('hu-HU')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');

      toc.innerHTML = '';
      headings.forEach((heading, index) => {
        const label = heading.textContent?.trim() || `Fejezet ${index + 1}`;
        if (!heading.id) heading.id = `${slugify(label) || 'fejezet'}-${index + 1}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = label;
        link.className = 'block border-l border-transparent pl-3 -ml-[21px] hover:border-signal-400 hover:text-white transition-colors';
        toc.appendChild(link);
      });
    })();
  </script>
</BaseLayout>
