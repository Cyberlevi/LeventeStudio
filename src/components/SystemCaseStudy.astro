---
import { ArrowRight, CheckCircle2 } from 'lucide-react';
import HeaderAstro from './HeaderAstro.astro';
import Footer from './Footer';
import MobileStickyBar from './MobileStickyBar';
import SubpageHero from './SubpageHero.astro';
interface Section { title:string; body:string; }
interface ProofMetric { value:string; label:string; detail?:string; }
interface Props { eyebrow:string; title:string; lead:string; stack:string[]; sections:Section[]; built:string[]; lessons:string[]; liveUrl?:string; proofMetrics?:ProofMetric[]; proofLabel?:string; proofNote?:string; proofFlow?:string[]; coverImage?:string; coverAlt?:string; }
const {eyebrow,title,lead,stack,sections,built,lessons,liveUrl,proofMetrics=[],proofLabel='Bizonyítási réteg',proofNote,proofFlow=[],coverImage,coverAlt='Élő projekt képernyőképe'}=Astro.props;
---
<MobileStickyBar/><div class="min-h-screen bg-graphite-950 text-white"><HeaderAstro/><main><SubpageHero eyebrow={eyebrow} title={title} description={lead} primaryHref="#bizonyitek" primaryLabel="Mutasd a bizonyítékot" secondaryHref="#rendszer" secondaryLabel="Mit építettünk" meta={stack.slice(0,4)}/>
{coverImage&&<section class="bg-graphite-950 px-5 pb-8 sm:px-6 lg:px-8"><div class="mx-auto max-w-6xl"><a href={liveUrl||coverImage} target={liveUrl?'_blank':undefined} rel={liveUrl?'noopener noreferrer':undefined} class="group block overflow-hidden rounded-xl border border-white/15 bg-ivory-100 shadow-2xl shadow-black/40"><div class="flex items-center justify-between border-b border-graphite-950/10 px-4 py-3 text-graphite-600"><span class="flex gap-1.5" aria-hidden="true"><span class="h-2 w-2 rounded-full bg-graphite-300"></span><span class="h-2 w-2 rounded-full bg-graphite-300"></span><span class="h-2 w-2 rounded-full bg-graphite-300"></span></span><span class="text-xs">{liveUrl?new URL(liveUrl).hostname:'Élő projekt'}</span><ArrowRight className="h-4 w-4 -rotate-45 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"/></div><img src={coverImage} alt={coverAlt} width="1348" height="926" loading="eager" decoding="async" class="aspect-[1.456] w-full object-cover object-top"/></a></div></section>}
{(proofMetrics.length>0||proofFlow.length>0)&&<section id="bizonyitek" class="hightech-section bg-graphite-950 relative overflow-hidden"><div class="absolute inset-0 subpage-signal-grid opacity-25 pointer-events-none"></div><div class="hightech-container relative"><div class="grid lg:grid-cols-[.72fr_1.28fr] gap-8 lg:gap-14 items-end mb-10"><div><div class="signal-kicker mb-4"><span class="signal-dot"></span>{proofLabel}</div><h2 class="font-serif text-4xl md:text-6xl font-light leading-[.95]">Ne csak az ígéretet nézd. <span class="text-signal-400">Nézd, mi működik.</span></h2></div><p class="text-white/55 text-lg font-light leading-relaxed max-w-2xl">{proofNote||'A konkrét teljesítményszámokat csak akkor publikáljuk, amikor a mérési forrásból visszaigazolhatók. Addig azt mutatjuk meg, mi működik élesben és mit mérünk.'}</p></div>{proofMetrics.length>0&&<div class="grid md:grid-cols-3 gap-px bg-white/10 border border-white/10">{proofMetrics.map(metric=><div class="bg-graphite-950 p-6 md:p-8"><div class="text-3xl md:text-4xl font-light text-signal-400">{metric.value}</div><div class="mt-3 text-white font-medium">{metric.label}</div>{metric.detail&&<div class="mt-2 text-sm text-white/55 leading-relaxed">{metric.detail}</div>}</div>)}</div>}{proofFlow.length>0&&<div class="mt-6 border border-white/10 p-6 md:p-8"><div class="text-[10px] uppercase tracking-[.18em] text-white/55 mb-6">Mérhető ügyfélút</div><div class="flex flex-col md:flex-row md:items-center gap-3">{proofFlow.map((step,index)=><div class="contents"><div class="flex-1 bg-white/[.035] border border-white/10 px-4 py-4"><div class="text-[10px] text-signal-400 mb-1">0{index+1}</div><div class="text-sm text-white/75">{step}</div></div>{(index < proofFlow.length - 1) && <ArrowRight className="w-4 h-4 text-white/25 rotate-90 md:rotate-0 shrink-0"/>}</div>)}</div></div>}</div></section>}
<section id="rendszer" class="hightech-section bg-graphite-900 relative overflow-hidden"><div class="absolute inset-0 studio-grid-dark opacity-20 pointer-events-none"></div><div class="hightech-container relative grid lg:grid-cols-[1.15fr_.85fr] gap-10 lg:gap-16 items-start"><div class="space-y-10 md:space-y-14">{sections.map((section,index)=><section class="grid md:grid-cols-[72px_1fr] gap-5 md:gap-8 border-t border-white/10 pt-7 md:pt-9"><div class="text-xs tracking-[.18em] text-signal-400">{String(index+1).padStart(2,'0')}</div><div><h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-light tracking-editorial text-white mb-4 text-balance">{section.title}</h2><p class="text-base sm:text-lg text-white/55 font-light leading-relaxed max-w-3xl">{section.body}</p></div></section>)}</div><aside class="lg:sticky lg:top-28"><div class="system-panel text-white p-6 sm:p-8 md:p-9 border border-signal-400/20 relative overflow-hidden"><div class="absolute inset-0 subpage-signal-grid opacity-25 pointer-events-none"></div><div class="relative"><div class="flex items-center justify-between gap-4 mb-7"><p class="text-xs uppercase tracking-[.2em] text-white/55">Mit építettünk</p><span class="inline-flex items-center gap-2 text-xs uppercase tracking-[.16em] text-signal-400"><span class="signal-dot"></span>éles projekt</span></div><ul class="space-y-4 mb-9">{built.map((item,index)=><li class="flex gap-3 text-white/70 font-light border-b border-white/[.07] pb-4 last:border-0 last:pb-0"><span class="text-xs text-signal-400 pt-1">{String(index+1).padStart(2,'0')}</span><CheckCircle2 className="w-5 h-5 mt-0.5 flex-shrink-0 text-signal-400"/><span>{item}</span></li>)}</ul>{liveUrl&&<a href={liveUrl} target="_blank" rel="noopener noreferrer" class="signal-button-primary w-full sm:w-auto">Élő projekt <ArrowRight className="w-4 h-4"/></a>}</div></div></aside></div></section>
<section class="hightech-section bg-graphite-950 relative overflow-hidden"><div class="absolute inset-0 subpage-signal-grid opacity-30 pointer-events-none"></div><div class="hightech-container relative"><div class="grid lg:grid-cols-[.7fr_1.3fr] gap-10 lg:gap-16 mb-10 md:mb-14"><div><div class="signal-kicker mb-4"><span class="signal-dot"></span>Tapasztalatok</div><h2 class="font-serif text-4xl md:text-6xl font-light tracking-editorial leading-[.95] text-balance">Nem kirakat. <span class="text-signal-400">Működési tapasztalat.</span></h2></div><p class="text-lg text-white/55 font-light leading-relaxed max-w-2xl lg:pt-10">A rendszerből azt visszük tovább, ami éles üzleti helyzetben is működőképesnek bizonyul.</p></div><div class="grid md:grid-cols-2 gap-4 md:gap-5">{lessons.map((lesson,index)=><div class="tech-card-dark p-6 md:p-7"><div class="text-xs text-signal-400 tracking-[.18em] mb-5">{String(index+1).padStart(2,'0')}</div><p class="text-white/70 font-light leading-relaxed">{lesson}</p></div>)}</div></div></section>
<section class="hightech-section bg-signal-400 text-graphite-950"><div class="hightech-container flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8"><div class="max-w-3xl"><div class="text-xs uppercase tracking-[.2em] opacity-60 mb-4">Következő lépés</div><h2 class="font-serif text-4xl sm:text-5xl md:text-6xl font-light tracking-editorial leading-[.95] text-balance">Hasonló rendszert szeretnél a saját vállalkozásodnak?</h2></div><a href="/kapcsolat/#diagnosztika" data-track-cta="case study ajánlatkérés" data-track-location="case_study_bottom" class="inline-flex items-center justify-center gap-3 px-7 py-4 bg-graphite-950 text-white hover:bg-graphite-900 transition-colors whitespace-nowrap">Ajánlatot kérek <ArrowRight className="w-5 h-5"/></a></div></section></main><Footer/></div>