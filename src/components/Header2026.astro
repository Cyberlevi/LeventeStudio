---
const navLinks = [
  { path: '/ai-webfejlesztes/', label: 'Megoldások' },
  { path: '/esettanulmanyok/', label: 'Lab / munkák' },
  { path: '/blog/', label: 'Tudástár' },
  { path: '/rolam/', label: 'Rólam' }
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-graphite-950/80 text-ivory-100 backdrop-blur-xl">
  <div class="mx-auto flex max-w-[86rem] items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-3" aria-label="Levente Studio főoldal">
      <span class="flex h-9 w-9 items-center justify-center border border-white/15 text-xs font-medium tracking-[0.16em] text-signal-300 transition group-hover:border-signal-300/50">LS</span>
      <span class="leading-none">
        <span class="block text-sm font-medium tracking-[0.14em]">LEVENTE</span>
        <span class="mt-1 block text-[9px] uppercase tracking-[0.28em] text-ivory-400">studio / systems</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Fő navigáció">
      {navLinks.map(link => (
        <a href={link.path} class="text-sm text-ivory-400 transition hover:text-ivory-100">{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="#diagnosztika" class="hidden bg-signal-300 px-5 py-3 text-sm font-medium text-graphite-950 transition hover:bg-signal-500 md:inline-flex">
        2 perces diagnózis
      </a>
      <button id="mobile-menu-button-2026" class="inline-flex h-10 w-10 items-center justify-center border border-white/15 text-ivory-100 lg:hidden" aria-label="Menü megnyitása" aria-expanded="false" aria-controls="mobile-menu-2026">
        <span class="text-lg">☰</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu-2026" class="hidden border-t border-white/10 bg-graphite-950 px-6 py-5 lg:hidden" aria-label="Mobil navigáció">
    <div class="mx-auto flex max-w-[86rem] flex-col gap-4">
      {navLinks.map(link => (
        <a href={link.path} class="mobile-2026-link py-1 text-base text-ivory-400">{link.label}</a>
      ))}
      <a href="#diagnosztika" class="mobile-2026-link mt-2 inline-flex justify-center bg-signal-300 px-5 py-3 font-medium text-graphite-950">2 perces diagnózis</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const button = document.getElementById('mobile-menu-button-2026');
    const menu = document.getElementById('mobile-menu-2026');
    if (!button || !menu) return;

    button.addEventListener('click', () => {
      const open = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      button.setAttribute('aria-expanded', String(!open));
    });

    document.querySelectorAll('.mobile-2026-link').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
