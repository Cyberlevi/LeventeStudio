---
import { studioOffers, referenceProjects } from '../data/studio-offers';
interface Props { headingLevel?: 'h1' | 'h2'; }
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel === 'h1' ? 'h1' : 'h2';
const fieldClass = 'w-full rounded-sm border border-white/20 bg-graphite-900 px-4 py-3.5 text-white outline-none focus:border-signal-400';
---
<section id="diagnosztika" class="hightech-section scroll-mt-20 text-white">
  <div class="hightech-container grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="mb-5 text-xs uppercase tracking-[.2em] text-signal-300">Beszéljünk a weboldaladról</p>
      <Heading class="font-serif text-5xl font-light leading-[1.02] tracking-editorial sm:text-6xl">Mire lenne<br />szükséged?</Heading>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-ivory-300">Írd meg néhány mondatban, mivel foglalkozol és mit szeretnél megvalósítani. Személyesen átnézem, és e-mailben egyeztetünk a következő lépésről.</p>
      <ol class="mt-8 space-y-4 text-sm text-ivory-300">
        <li class="border-t border-white/15 pt-4"><span class="mr-3 text-signal-400">01</span>Röviden bemutatod a vállalkozásodat.</li>
        <li class="border-t border-white/15 pt-4"><span class="mr-3 text-signal-400">02</span>Tisztázzuk a feladatot és a szükséges tartalmat.</li>
        <li class="border-t border-white/15 pt-4"><span class="mr-3 text-signal-400">03</span>Írásos ajánlatot kapsz a megbeszélt munkára.</li>
      </ol>
      <p class="mt-8 text-sm text-ivory-400">Inkább közvetlenül írnál?<br /><a href="mailto:hello@leventestudio.app" class="mt-2 inline-block text-ivory-100 underline underline-offset-4">hello@leventestudio.app</a></p>
    </div>
    <form id="system-diagnostic-form" name="system-diagnostic" method="POST" action="/koszonjuk/" data-netlify="true" netlify-honeypot="bot-field" class="relative overflow-hidden rounded-xl border border-white/15 p-5 sm:p-8">
      <input type="hidden" name="form-name" value="system-diagnostic" />
      <input type="hidden" name="source_page" />
      <input type="hidden" name="entry_page" />
      <input type="hidden" name="recommended_system" />
      {['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid'].map(name => <input type="hidden" name={name} />)}
      <p class="hidden" aria-hidden="true"><label>Ezt a mezőt hagyd üresen:<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="grid gap-5 sm:grid-cols-2">
        <div><label for="lead-name" class="mb-2 block text-sm text-ivory-300">Neved *</label><input id="lead-name" name="name" type="text" autocomplete="name" maxlength="120" required class={fieldClass} /></div>
        <div><label for="lead-email" class="mb-2 block text-sm text-ivory-300">E-mail-címed *</label><input id="lead-email" name="email" type="email" autocomplete="email" maxlength="254" required class={fieldClass} /></div>
        <div><label for="lead-business" class="mb-2 block text-sm text-ivory-300">Mivel foglalkozol? *</label><input id="lead-business" name="business_type" type="text" placeholder="Például klímaszerelés, kutyakozmetika" maxlength="200" required class={fieldClass} /></div>
        <div><label for="lead-website" class="mb-2 block text-sm text-ivory-300">Weboldalad, ha már van</label><input id="lead-website" name="website" type="text" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="ceged.hu" maxlength="500" aria-describedby="lead-website-hint" class={fieldClass} /><p id="lead-website-hint" class="mt-1.5 text-xs leading-relaxed text-ivory-400">Elég a cím, például <span class="text-ivory-300">ceged.hu</span> — a https:// előtagot automatikusan kezeljük.</p></div>
        <div class="sm:col-span-2"><label for="lead-goal" class="mb-2 block text-sm text-ivory-300">Miben segíthetünk? *</label><select id="lead-goal" name="primary_goal" required class={fieldClass}>
          <option value="">Válassz egy kiindulópontot</option><option value="audit">A meglévő weboldalamat szeretném átnézetni / javítani</option><option value="presence">Egyszerű bemutatkozó weboldalt szeretnék</option><option value="rebuild">Új vagy megújított céges weboldalt szeretnék</option><option value="more-leads">Az ügyfélszerzést szeretném fejleszteni</option><option value="measurement">Látni szeretném, honnan jönnek a megkeresések</option><option value="automation">Kevesebb kézi adminisztrációt szeretnék</option><option value="maintenance">Weboldalgondozás érdekel</option><option value="unknown">Segíts eldönteni, mire van szükségem</option>
        </select></div>
        <div class="sm:col-span-2"><label for="lead-note" class="mb-2 block text-sm text-ivory-300">Néhány szó az elképzelésedről</label><textarea id="lead-note" name="note" rows="3" maxlength="3000" placeholder="Mit szeretnél megmutatni vagy egyszerűbbé tenni?" class={fieldClass}></textarea></div>
      </div>
      <details id="inquiry-preferences" class="mt-5 rounded-sm border border-white/15 p-4">
        <summary class="cursor-pointer text-sm text-ivory-300">Csomag és referencia <span class="text-ivory-400">(ha már választottál)</span></summary>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div><label for="selected-package" class="mb-2 block text-sm text-ivory-300">Melyik csomag érdekel?</label><select id="selected-package" name="selected_package" class={fieldClass}><option value="">Még nem döntöttem</option>{studioOffers.map(offer => <option value={offer.id}>{offer.id} · {offer.price}</option>)}</select></div>
          <div><label for="reference-project" class="mb-2 block text-sm text-ivory-300">Melyik munkánk tetszett?</label><select id="reference-project" name="reference_project" class={fieldClass}><option value="">Nincs kiválasztott referencia</option>{referenceProjects.map(project => <option value={project.id}>{project.name}</option>)}</select></div>
        </div>
      </details>
      <label class="mt-6 flex items-start gap-3 text-sm leading-relaxed text-ivory-300"><input type="checkbox" name="privacy_acknowledged" value="yes" required class="mt-1 accent-[#d8ff78]" /><span>Elolvastam az <a href="/adatvedelem/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">adatvédelmi tájékoztatót</a>, és kérem, hogy a megkeresésemre a megadott címen válaszoljanak. *</span></label>
      <p id="inquiry-error" role="alert" hidden class="mt-5 border border-red-300/40 bg-red-950/30 p-4 text-sm leading-relaxed text-red-100"></p>
      <button type="submit" class="signal-button-primary mt-6 w-full disabled:cursor-wait disabled:opacity-60">Elküldöm az ajánlatkérést <span aria-hidden="true">↗</span></button>
      <p id="inquiry-status" role="status" class="mt-4 text-xs leading-relaxed text-ivory-400">Az ajánlatkérés díjmentes, és nem jár megrendelési kötelezettséggel.</p>
      <noscript><p class="mt-3 text-sm text-ivory-300">A kiválasztott csomagot és referenciát a fenti lenyitható részben tudod megadni.</p></noscript>
    </form>
  </div>
</section>
<script>
  import '../scripts/inquiry-form';
</script>
