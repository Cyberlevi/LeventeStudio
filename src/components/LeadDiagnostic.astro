---
---

<section id="diagnosztika" class="hightech-section bg-graphite-950 text-white scroll-mt-24 relative overflow-hidden">
  <div class="absolute inset-0 studio-grid-dark pointer-events-none opacity-70" aria-hidden="true"></div>

  <div class="hightech-container relative grid lg:grid-cols-[0.72fr_1.28fr] gap-10 lg:gap-16 items-start">
    <div class="lg:sticky lg:top-28">
      <div class="text-xs uppercase tracking-[0.18em] text-signal-400 mb-4">2 perces rendszerdiagnózis</div>
      <h2 class="editorial-heading mb-6 text-white">
        Hol veszít most
        <span class="block text-white/45">érdeklődőt vagy időt a rendszered?</span>
      </h2>
      <p class="text-base sm:text-lg text-white/60 font-light leading-relaxed mb-8 max-w-xl">
        Nem kell briefet írnod. Add meg az alapokat, én pedig már a vállalkozásod és a jelenlegi ügyfélút alapján nézem meg, hol érdemes először hozzányúlni.
      </p>

      <div class="space-y-3">
        {[
          ['01', 'Kb. 2 perc kitölteni'],
          ['02', 'Nem automata sales sorozatba kerülsz'],
          ['03', 'A választ ember nézi át']
        ].map(([number, text]) => (
          <div class="flex items-center gap-4 border-b border-white/10 py-3">
            <span class="text-[10px] uppercase tracking-[0.18em] text-signal-400">{number}</span>
            <span class="text-sm text-white/65">{text}</span>
          </div>
        ))}
      </div>
    </div>

    <form id="system-diagnostic-form" name="system-diagnostic" method="POST" action="/koszonjuk/" data-netlify="true" netlify-honeypot="bot-field" class="bg-graphite-950 text-white border border-white/10 p-5 sm:p-7 md:p-9 lg:p-10 shadow-2xl shadow-black/10 relative overflow-hidden">
      <div class="absolute inset-0 subpage-signal-grid opacity-25 pointer-events-none"></div>
      <div class="relative">
        <div class="flex items-center justify-between gap-5 border-b border-white/10 pb-5 mb-7">
          <div><div class="text-[10px] uppercase tracking-[0.18em] text-white/35 mb-1">Első lépés</div><div class="text-lg text-white">Mutasd meg röviden, hol tartasz</div></div>
          <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-signal-400"><span class="signal-dot"></span>~2 perc</span>
        </div>

        <input type="hidden" name="form-name" value="system-diagnostic" />
        <input type="hidden" name="source_page" id="lead-source-page" value="homepage" />
        <input type="hidden" name="utm_source" id="lead-utm-source" /><input type="hidden" name="utm_medium" id="lead-utm-medium" /><input type="hidden" name="utm_campaign" id="lead-utm-campaign" /><input type="hidden" name="utm_term" id="lead-utm-term" /><input type="hidden" name="utm_content" id="lead-utm-content" /><input type="hidden" name="gclid" id="lead-gclid" />
        <p class="hidden" aria-hidden="true"><label>Ezt a mezőt hagyd üresen:<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div class="grid md:grid-cols-2 gap-4 sm:gap-5">
          <div><label for="lead-name" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Név *</label><input id="lead-name" name="name" type="text" autocomplete="name" required class="w-full border border-white/[0.12] bg-white/[0.045] px-4 py-3.5 text-white outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400" /></div>
          <div><label for="lead-email" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">E-mail *</label><input id="lead-email" name="email" type="email" autocomplete="email" required class="w-full border border-white/[0.12] bg-white/[0.045] px-4 py-3.5 text-white outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400" /></div>
        </div>

        <div class="grid md:grid-cols-2 gap-4 sm:gap-5 mt-5">
          <div><label for="lead-business" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Milyen vállalkozás? *</label><input id="lead-business" name="business_type" type="text" placeholder="pl. klíma, építőipar, szépségipar" required class="w-full border border-white/[0.12] bg-white/[0.045] px-4 py-3.5 text-white placeholder:text-white/25 outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400" /></div>
          <div><label for="lead-website" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Weboldal <span class="normal-case tracking-normal text-white/25">(ha van)</span></label><input id="lead-website" name="website" type="url" inputmode="url" placeholder="https://" class="w-full border border-white/[0.12] bg-white/[0.045] px-4 py-3.5 text-white placeholder:text-white/25 outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400" /></div>
        </div>

        <div class="grid md:grid-cols-2 gap-4 sm:gap-5 mt-5">
          <div><label for="lead-goal" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Mit szeretnél javítani? *</label><select id="lead-goal" name="primary_goal" required class="w-full border border-white/[0.12] bg-graphite-900 px-4 py-3.5 text-white outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400"><option value="">Válassz</option><option value="more-leads">Több érdeklődő</option><option value="better-leads">Jobb minőségű érdeklődők</option><option value="measurement">Látni, miből lesz ügyfél</option><option value="automation">Kevesebb kézi adminisztráció</option><option value="rebuild">Weboldal / rendszer újraépítése</option><option value="unknown">Nem tudom még pontosan</option></select></div>
          <div><label for="lead-bottleneck" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Hol érzed az elakadást? <span class="normal-case tracking-normal text-white/25">(opcionális)</span></label><select id="lead-bottleneck" name="bottleneck" class="w-full border border-white/[0.12] bg-graphite-900 px-4 py-3.5 text-white outline-none focus:border-signal-400 focus:ring-1 focus:ring-signal-400"><option value="">Nem tudom / kihagyom</option><option value="traffic">Kevés releváns forgalom</option><option value="conversion">Jönnek látogatók, de kevés a megkeresés</option><option value="tracking">Nem látom, miből lesz ügyfél</option><option value="lead-handling">Szétesik a leadkezelés</option><option value="manual-work">Túl sok a kézi munka</option></select></div>
        </div>

        <details class="mt-5 border border-white/10 bg-white/[0.025] p-4">
          <summary class="cursor-pointer text-sm text-white/65">+ Ha szeretnél, adj még egy kis kontextust</summary>
          <div class="grid md:grid-cols-2 gap-4 sm:gap-5 mt-5">
            <div><label for="lead-volume" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Havi megkeresések</label><select id="lead-volume" name="monthly_inquiries" class="w-full border border-white/[0.12] bg-graphite-900 px-4 py-3.5 text-white outline-none focus:border-signal-400"><option value="">Nem tudom / kihagyom</option><option value="0-5">0–5</option><option value="6-20">6–20</option><option value="21-50">21–50</option><option value="51+">51+</option></select></div>
            <div><label for="lead-note" class="block text-xs uppercase tracking-[0.14em] text-white/45 mb-2">Rövid megjegyzés</label><textarea id="lead-note" name="note" rows="3" placeholder="Mi az, amin most leginkább változtatnál?" class="w-full border border-white/[0.12] bg-white/[0.045] px-4 py-3.5 text-white placeholder:text-white/25 outline-none focus:border-signal-400 resize-y"></textarea></div>
          </div>
        </details>

        <label class="flex items-start gap-3 mt-6 text-sm text-white/55 leading-relaxed"><input type="checkbox" name="privacy_acknowledged" value="yes" required class="mt-1 accent-[#d8ff78]" /><span>Elolvastam az <a href="/adatvedelem/" target="_blank" rel="noopener noreferrer" class="underline decoration-signal-400 underline-offset-4 text-white">adatvédelmi tájékoztatót</a>, és kérem, hogy a megadott elérhetőségemen a megkeresésemre válaszoljanak. *</span></label>

        <button type="submit" class="mt-7 w-full bg-signal-400 text-graphite-950 px-7 py-4 text-base font-medium hover:bg-signal-300 transition-colors focus:outline-none focus:ring-2 focus:ring-signal-400 focus:ring-offset-2 focus:ring-offset-graphite-950">Kérem a rendszerdiagnózist →</button>
        <div class="mt-4 flex flex-col gap-2 text-[10px] sm:flex-row sm:items-center sm:justify-between sm:text-xs uppercase tracking-[0.14em] text-white/30"><span>Nincs automata sales sorozat</span><span class="text-signal-400">emberi átnézés</span></div>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const mapping = {'lead-utm-source':'utm_source','lead-utm-medium':'utm_medium','lead-utm-campaign':'utm_campaign','lead-utm-term':'utm_term','lead-utm-content':'utm_content','lead-gclid':'gclid'};
    Object.entries(mapping).forEach(([id,key]) => { const input = document.getElementById(id); if (input instanceof HTMLInputElement) input.value = params.get(key) || ''; });
    const sourcePage = document.getElementById('lead-source-page'); if (sourcePage instanceof HTMLInputElement) sourcePage.value = window.location.pathname;
    const form = document.getElementById('system-diagnostic-form'); if (form instanceof HTMLFormElement) form.addEventListener('submit', () => { try { sessionStorage.setItem('ls_lead_submission_pending_v1','1'); } catch (_) {} });
  })();
</script>