---
interface Props {
  variant?: 'split' | 'flow' | 'converge';
  label?: string;
}

const { variant = 'flow', label = 'SIGNAL / SYSTEM' } = Astro.props;
const [source = label, target = 'SYSTEM'] = label.split('→').map((part) => part.trim());
const sequence = variant === 'split' ? '01' : variant === 'flow' ? '02' : '03';
---

<div class:list={['signal-bridge', `signal-bridge--${variant}`]} aria-hidden="true">
  <div class="signal-bridge__inner">
    <span class="signal-bridge__sequence">{sequence}</span>
    <span class="signal-bridge__source">{source}</span>
    <span class="signal-bridge__route">
      <i></i>
      <b></b>
    </span>
    <span class="signal-bridge__target">{target}</span>
    <span class="signal-bridge__meta">LEVENTE STUDIO / SIGNAL ROUTE</span>
    <div class="signal-bridge__rail signal-bridge__rail--a"></div>
    <div class="signal-bridge__rail signal-bridge__rail--b"></div>
    <div class="signal-bridge__rail signal-bridge__rail--c"></div>
    <span class="signal-bridge__node signal-bridge__node--a"></span>
    <span class="signal-bridge__node signal-bridge__node--b"></span>
  </div>
</div>

<style>
  .signal-bridge {
    position: relative;
    height: clamp(7.5rem, 12vw, 11rem);
    overflow: hidden;
    background: #0b0d0c;
    pointer-events: none;
    border-top: 1px solid rgba(244,240,232,.07);
    border-bottom: 1px solid rgba(244,240,232,.07);
  }

  .signal-bridge::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .28;
    background-image:
      linear-gradient(rgba(244,240,232,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244,240,232,.035) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }

  .signal-bridge__inner {
    position: absolute;
    inset: 0;
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(4rem, .42fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(.8rem, 2vw, 2rem);
  }

  .signal-bridge__sequence {
    align-self: start;
    margin-top: 1.4rem;
    color: rgba(216,255,120,.72);
    font-size: .58rem;
    line-height: 1;
    letter-spacing: .2em;
  }

  .signal-bridge__source,
  .signal-bridge__target {
    position: relative;
    z-index: 2;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 5.75rem);
    font-weight: 300;
    line-height: .8;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  .signal-bridge__source {
    color: rgba(244,240,232,.34);
  }

  .signal-bridge__target {
    color: #d8ff78;
    font-style: italic;
    text-shadow: 0 0 50px rgba(216,255,120,.08);
  }

  .signal-bridge__route {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-width: 4rem;
  }

  .signal-bridge__route i {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(216,255,120,.1), rgba(216,255,120,.9));
    box-shadow: 0 0 18px rgba(216,255,120,.14);
  }

  .signal-bridge__route b {
    display: block;
    width: .48rem;
    height: .48rem;
    margin-left: -.24rem;
    border-top: 1px solid #d8ff78;
    border-right: 1px solid #d8ff78;
    transform: rotate(45deg);
  }

  .signal-bridge__meta {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: 1rem;
    color: rgba(244,240,232,.25);
    font-size: .5rem;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .signal-bridge__rail {
    position: absolute;
    height: 1px;
    transform-origin: left center;
    background: linear-gradient(90deg, transparent, rgba(216,255,120,.12), rgba(216,255,120,.74), rgba(216,255,120,.08), transparent);
    background-size: 220% 100%;
    animation: bridge-scan 9s linear infinite;
    box-shadow: 0 0 16px rgba(216,255,120,.05);
  }

  .signal-bridge__node {
    position: absolute;
    width: .34rem;
    height: .34rem;
    margin: -.17rem 0 0 -.17rem;
    border-radius: 999px;
    background: #d8ff78;
    box-shadow: 0 0 0 5px rgba(216,255,120,.035), 0 0 24px rgba(216,255,120,.28);
  }

  .signal-bridge--flow .signal-bridge__rail--a {
    left: 16%;
    right: 6%;
    top: 68%;
    transform: rotate(-1.5deg);
  }

  .signal-bridge--flow .signal-bridge__rail--b,
  .signal-bridge--flow .signal-bridge__rail--c {
    display: none;
  }

  .signal-bridge--flow .signal-bridge__node--a {
    left: 66%;
    top: 67%;
  }

  .signal-bridge--flow .signal-bridge__node--b {
    display: none;
  }

  .signal-bridge--split .signal-bridge__rail--a {
    left: 23%;
    width: 46%;
    top: 72%;
  }

  .signal-bridge--split .signal-bridge__rail--b {
    left: 61%;
    width: 30%;
    top: 72%;
    transform: rotate(-10deg);
  }

  .signal-bridge--split .signal-bridge__rail--c {
    left: 61%;
    width: 27%;
    top: 72%;
    transform: rotate(9deg);
  }

  .signal-bridge--split .signal-bridge__node--a {
    left: 61%;
    top: 72%;
  }

  .signal-bridge--split .signal-bridge__node--b {
    left: 82%;
    top: 88%;
    opacity: .55;
  }

  .signal-bridge--converge .signal-bridge__rail--a {
    left: 20%;
    width: 34%;
    top: 72%;
    transform: rotate(8deg);
  }

  .signal-bridge--converge .signal-bridge__rail--b {
    left: 23%;
    width: 31%;
    top: 88%;
    transform: rotate(-9deg);
  }

  .signal-bridge--converge .signal-bridge__rail--c {
    left: 54%;
    right: 7%;
    top: 76%;
  }

  .signal-bridge--converge .signal-bridge__node--a {
    left: 54%;
    top: 76%;
  }

  .signal-bridge--converge .signal-bridge__node--b {
    left: 80%;
    top: 76%;
    opacity: .45;
  }

  @keyframes bridge-scan {
    from { background-position: 220% 0; }
    to { background-position: -120% 0; }
  }

  @media (max-width: 767px) {
    .signal-bridge {
      height: 6.75rem;
    }

    .signal-bridge__inner {
      grid-template-columns: auto minmax(0, 1fr) 2.5rem minmax(0, 1fr);
      gap: .65rem;
    }

    .signal-bridge__sequence {
      margin-top: 1rem;
      font-size: .48rem;
    }

    .signal-bridge__source,
    .signal-bridge__target {
      font-size: clamp(1.55rem, 9vw, 2.65rem);
    }

    .signal-bridge__meta {
      right: 1.25rem;
      bottom: .7rem;
      font-size: .42rem;
      letter-spacing: .16em;
    }

    .signal-bridge__rail {
      opacity: .78;
      animation: none;
    }

    .signal-bridge--split .signal-bridge__rail--a,
    .signal-bridge--flow .signal-bridge__rail--a,
    .signal-bridge--converge .signal-bridge__rail--c {
      left: 12%;
      right: 10%;
      width: auto;
      top: 76%;
      transform: none;
    }

    .signal-bridge--split .signal-bridge__rail--b,
    .signal-bridge--split .signal-bridge__rail--c,
    .signal-bridge--converge .signal-bridge__rail--a,
    .signal-bridge--converge .signal-bridge__rail--b {
      display: none;
    }

    .signal-bridge--split .signal-bridge__node--a,
    .signal-bridge--flow .signal-bridge__node--a,
    .signal-bridge--converge .signal-bridge__node--a {
      left: 72%;
      top: 76%;
    }

    .signal-bridge__node--b {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-bridge__rail {
      animation: none;
    }
  }
</style>
