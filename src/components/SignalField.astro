---
interface Props {
  intensity?: number;
  class?: string;
}
const { intensity = 1, class: className = '' } = Astro.props;
---

<div class:list={['signal-field-host absolute inset-0 overflow-hidden pointer-events-none', className]} data-signal-field data-intensity={intensity} aria-hidden="true">
  <canvas class="h-full w-full opacity-95" data-signal-canvas></canvas>
  <div class="signal-field-fallback absolute inset-0"></div>
</div>

<script>
  const media = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
  const connection = navigator.connection;
  const saveData = Boolean(connection && connection.saveData);

  if (media.matches && !saveData) {
    const boot = async () => {
      const { bootSignalFields } = await import('../scripts/signal-field');
      bootSignalFields();
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void boot(), { timeout: 700 });
    } else {
      window.setTimeout(() => void boot(), 160);
    }
  } else {
    document.querySelectorAll('[data-signal-field]').forEach((host) => {
      if (!(host instanceof HTMLElement)) return;
      host.dataset.signalFallback = 'true';
      const canvas = host.querySelector('canvas');
      if (canvas instanceof HTMLCanvasElement) canvas.hidden = true;
    });
  }
</script>
