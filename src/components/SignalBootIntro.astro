---
---

<div id="ls-boot-intro" class="ls-boot-intro" aria-hidden="true">
  <div class="ls-boot-intro__grid" aria-hidden="true"></div>
  <div class="ls-boot-intro__scan" aria-hidden="true"></div>
  <div class="ls-boot-intro__shutter ls-boot-intro__shutter--top" aria-hidden="true"></div>
  <div class="ls-boot-intro__shutter ls-boot-intro__shutter--bottom" aria-hidden="true"></div>
  <div class="ls-boot-intro__flash" aria-hidden="true"></div>

  <div class="ls-boot-intro__content">
    <div class="ls-boot-intro__meta">
      <span>LS / SYSTEM ENTRY</span>
      <span class="ls-boot-intro__meta-line"></span>
      <span>47.4979° N · 19.0402° E</span>
    </div>

    <div class="ls-boot-intro__center">
      <div class="ls-boot-intro__lock" aria-hidden="true">
        <span class="ls-boot-intro__lock-ring ls-boot-intro__lock-ring--outer"></span>
        <span class="ls-boot-intro__lock-ring ls-boot-intro__lock-ring--inner"></span>
        <span class="ls-boot-intro__lock-axis ls-boot-intro__lock-axis--x"></span>
        <span class="ls-boot-intro__lock-axis ls-boot-intro__lock-axis--y"></span>
        <span class="ls-boot-intro__lock-sweep"></span>
        <span class="ls-boot-intro__lock-core"></span>
      </div>

      <p class="ls-boot-intro__eyebrow">DIGITAL SYSTEM / BUDAPEST</p>

      <div class="ls-boot-intro__wordmark">
        <span>LEVENTE</span>
        <i aria-hidden="true"></i>
        <span class="ls-boot-intro__wordmark-studio">STUDIO</span>
      </div>

      <div class="ls-boot-intro__sequence" aria-hidden="true">
        <span style="--step: 0">STRATEGY <b>01</b></span>
        <span style="--step: 1">DESIGN <b>02</b></span>
        <span style="--step: 2">BUILD <b>03</b></span>
        <span style="--step: 3">AUTOMATE <b>04</b></span>
      </div>

      <div class="ls-boot-intro__track" aria-hidden="true">
        <span class="ls-boot-intro__progress"></span>
        <span class="ls-boot-intro__progress-head"></span>
      </div>

      <div class="ls-boot-intro__status">
        <span class="ls-boot-intro__status-dot"></span>
        <span class="ls-boot-intro__status-stage ls-boot-intro__status-stage--acquire">SIGNAL ACQUIRING</span>
        <span class="ls-boot-intro__status-stage ls-boot-intro__status-stage--online">SYSTEM ONLINE</span>
      </div>
    </div>

    <div class="ls-boot-intro__foot">
      <span>ENTRY / 01</span>
      <span>WEB · SYSTEM · AI</span>
      <span>BUILD 2026.09</span>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const root = document.documentElement;
  const intro = document.getElementById('ls-boot-intro');
  if (!intro || !root.classList.contains('ls-intro-pending')) return;

  const compact = window.matchMedia('(max-width: 767px)').matches;
  const onlineDelay = compact ? 980 : 1420;
  const revealDelay = compact ? 1420 : 1940;
  const completeDelay = compact ? 1900 : 2520;

  const finish = () => {
    root.classList.remove('ls-intro-pending', 'ls-intro-online', 'ls-intro-reveal');
    root.classList.add('ls-intro-complete');
    intro.hidden = true;
  };

  const onlineTimer = window.setTimeout(() => root.classList.add('ls-intro-online'), onlineDelay);
  const revealTimer = window.setTimeout(() => root.classList.add('ls-intro-reveal'), revealDelay);
  const completeTimer = window.setTimeout(finish, completeDelay);

  window.addEventListener('pagehide', () => {
    window.clearTimeout(onlineTimer);
    window.clearTimeout(revealTimer);
    window.clearTimeout(completeTimer);
  }, { once: true });
})();
</script>
