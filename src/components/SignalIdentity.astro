---
import { ArrowUpRight } from 'lucide-react';
---

<section class="signal-identity" aria-labelledby="signal-identity-title">
  <div class="signal-identity__grid" aria-hidden="true"></div>
  <div class="signal-identity__glow" aria-hidden="true"></div>

  <div class="signal-identity__shell">
    <div class="signal-identity__visual">
      <div class="signal-identity__frame" data-portrait-signal>
        <img
          data-portrait-image
          src="/levente_studio_portrait_final.webp"
          width="720"
          height="720"
          loading="lazy"
          decoding="async"
          alt="Tarnóczi Levente"
          class="signal-identity__portrait"
        />
        <canvas data-portrait-canvas class="signal-identity__canvas" aria-hidden="true"></canvas>
        <div class="signal-identity__scan" aria-hidden="true"></div>
        <div class="signal-identity__cross signal-identity__cross--a" aria-hidden="true"></div>
        <div class="signal-identity__cross signal-identity__cross--b" aria-hidden="true"></div>
      </div>

      <div class="signal-identity__telemetry" aria-hidden="true">
        <span>FIELD / EXPERIENCE</span>
        <span>WEB / SYSTEMS</span>
        <span>AI / ASSISTED</span>
      </div>
    </div>

    <div class="signal-identity__content">
      <p class="signal-kicker">
        <span class="signal-dot"></span>
        SIGNAL / HUMAN LAYER
      </p>

      <h2 id="signal-identity-title" class="signal-identity__title">
        A működés előbb jön.<br />
        <span>A látvány utána.</span>
      </h2>

      <p class="signal-identity__lead">
        Szakemberként azt tanultam meg, hogy egy megoldás nem attól jó, hogy jól néz ki a terven,
        hanem attól, hogy a valóságban is működik. Ugyanezt a gondolkodást viszem át a webre:
        tiszta rendszer, ellenőrizhető működés, erős megjelenés.
      </p>

      <div class="signal-identity__matrix" aria-label="A Levente Studio működésének három pillére">
        <div>
          <span class="signal-identity__index">01</span>
          <strong>Valós projektek</strong>
          <small>Saját szolgáltatásokon kipróbált rendszer.</small>
        </div>
        <div>
          <span class="signal-identity__index">02</span>
          <strong>Technikai kontroll</strong>
          <small>Nem template-logika, hanem mérhető működés.</small>
        </div>
        <div>
          <span class="signal-identity__index">03</span>
          <strong>AI gyorsítás</strong>
          <small>Eszköz a háttérben, emberi döntés elöl.</small>
        </div>
      </div>

      <a href="/rolam/" class="signal-identity__link">
        A történet mögött
        <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<style>
  .signal-identity {
    position: relative;
    content-visibility: auto;
    contain-intrinsic-size: 900px;
    overflow: hidden;
    isolation: isolate;
    background: #0b0d0c;
    color: #f4f0e8;
    padding: clamp(5rem, 10vw, 9rem) 1.25rem;
    border-top: 1px solid rgba(244,240,232,.08);
    border-bottom: 1px solid rgba(244,240,232,.08);
  }

  .signal-identity__grid {
    position: absolute;
    inset: 0;
    opacity: .32;
    background-image:
      linear-gradient(rgba(244,240,232,.038) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244,240,232,.038) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at 72% 48%, black 0%, transparent 72%);
  }

  .signal-identity__glow {
    position: absolute;
    width: 46rem;
    height: 46rem;
    right: -18rem;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(216,255,120,.11), rgba(216,255,120,.018) 42%, transparent 70%);
    filter: blur(18px);
  }

  .signal-identity__shell {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
    display: grid;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .signal-identity__visual {
    position: relative;
    max-width: 34rem;
    margin: 0 auto;
    width: 100%;
  }

  .signal-identity__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #151816;
    border: 1px solid rgba(244,240,232,.13);
    box-shadow: 0 36px 120px rgba(0,0,0,.38);
  }

  .signal-identity__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 52%, rgba(11,13,12,.64) 100%),
      linear-gradient(110deg, rgba(216,255,120,.05), transparent 32%);
  }

  .signal-identity__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(.72) contrast(1.04);
    transform: scale(1.015);
  }

  .signal-identity__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity .45s ease;
  }

  .signal-identity__scan {
    position: absolute;
    z-index: 3;
    inset: auto 8% 18%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(216,255,120,.88), transparent);
    box-shadow: 0 0 28px rgba(216,255,120,.23);
  }

  .signal-identity__cross {
    position: absolute;
    z-index: 4;
    width: .7rem;
    height: .7rem;
  }

  .signal-identity__cross::before,
  .signal-identity__cross::after {
    content: '';
    position: absolute;
    background: rgba(216,255,120,.78);
  }

  .signal-identity__cross::before {
    width: 100%;
    height: 1px;
    top: 50%;
    left: 0;
  }

  .signal-identity__cross::after {
    height: 100%;
    width: 1px;
    left: 50%;
    top: 0;
  }

  .signal-identity__cross--a {
    top: 12%;
    left: 8%;
  }

  .signal-identity__cross--b {
    right: 8%;
    bottom: 10%;
    opacity: .55;
  }

  .signal-identity__telemetry {
    position: absolute;
    left: -.75rem;
    right: -.75rem;
    bottom: -1rem;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    gap: .5rem;
    padding: .8rem 1rem;
    border: 1px solid rgba(244,240,232,.10);
    background: rgba(11,13,12,.80);
    backdrop-filter: blur(14px);
    color: rgba(244,240,232,.45);
    font-size: .48rem;
    line-height: 1;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .signal-identity__content {
    max-width: 48rem;
  }

  .signal-identity .signal-kicker {
    color: rgba(244,240,232,.78);
  }

  .signal-identity__title {
    margin-top: 1.5rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3.4rem, 7.5vw, 7.2rem);
    font-weight: 300;
    line-height: .86;
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  .signal-identity__title span {
    color: #d8ff78;
    font-style: italic;
  }

  .signal-identity__lead {
    max-width: 43rem;
    margin-top: 2rem;
    color: rgba(244,240,232,.78);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.75;
    font-weight: 300;
  }

  .signal-identity__matrix {
    margin-top: 2.4rem;
    display: grid;
    border-top: 1px solid rgba(244,240,232,.10);
    border-bottom: 1px solid rgba(244,240,232,.10);
  }

  .signal-identity__matrix > div {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: .25rem .8rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(244,240,232,.08);
  }

  .signal-identity__matrix > div:last-child {
    border-bottom: 0;
  }

  .signal-identity__index {
    grid-row: 1 / 3;
    color: #d8ff78;
    font-size: .56rem;
    line-height: 1.5rem;
    letter-spacing: .16em;
  }

  .signal-identity__matrix strong {
    font-weight: 500;
    color: rgba(244,240,232,.92);
    font-size: .92rem;
  }

  .signal-identity__matrix small {
    color: rgba(244,240,232,.74);
    font-size: .78rem;
    line-height: 1.5;
  }

  .signal-identity__link {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    margin-top: 2rem;
    padding-bottom: .25rem;
    border-bottom: 1px solid rgba(216,255,120,.55);
    color: #f4f0e8;
    font-size: .9rem;
    transition: color .2s ease, border-color .2s ease;
  }

  .signal-identity__link:hover {
    color: #d8ff78;
    border-color: #d8ff78;
  }

  @media (min-width: 900px) {
    .signal-identity {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .signal-identity__shell {
      grid-template-columns: .78fr 1.22fr;
    }

    .signal-identity__visual {
      margin-left: 0;
    }

    .signal-identity__matrix {
      grid-template-columns: repeat(3, 1fr);
    }

    .signal-identity__matrix > div {
      display: block;
      padding: 1.25rem 1.25rem 1.25rem 0;
      border-bottom: 0;
      border-right: 1px solid rgba(244,240,232,.08);
    }

    .signal-identity__matrix > div + div {
      padding-left: 1.25rem;
    }

    .signal-identity__matrix > div:last-child {
      border-right: 0;
      padding-right: 0;
    }

    .signal-identity__index {
      display: block;
      margin-bottom: .8rem;
    }

    .signal-identity__matrix strong,
    .signal-identity__matrix small {
      display: block;
    }

    .signal-identity__matrix small {
      margin-top: .45rem;
    }
  }

  @media (max-width: 899px) {
    .signal-identity__visual {
      max-width: 27rem;
    }

    .signal-identity__title {
      max-width: 9ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-identity__link {
      transition: none;
    }
  }
</style>


<script>
  import '../scripts/portrait-signal';
</script>
